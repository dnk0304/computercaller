{
  "manifest_version": 3,
  "name": "ComputerCaller",
  "version": "1.0.0",
  "description": "Make and receive phone calls and text messages from your browser. Your phone does the calling; your computer does the typing.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ComputerCaller",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["notifications", "storage", "identity", "alarms"],
  "host_permissions": ["https://computercaller.com/*"]
}
