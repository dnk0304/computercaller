generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  // Production: PostgreSQL on Hetzner via Coolify-managed instance.
  // Local dev uses Neon/Hetzner Postgres via a DATABASE_URL override in
  // .env.local. The sqlite dummy-mode rig that lived here through
  // 2026-05-22 has been retired — Phase 1 of the deploy plan (Ken
  // dispatch #14, 2026-05-24) flipped this back to postgres ahead of
  // the first Coolify push. If you need a zero-deps local rig again,
  // override DATABASE_URL to a sqlite file AND swap this provider line
  // — Prisma refuses cross-provider migrations.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  // passwordHash — nullable as of dispatch #36 (2026-05-25). Google-OAuth-only
  // users have no password set. Email/password users retain a hash; users who
  // started one way and later linked the other (authProvider = 'both') keep
  // their hash. The /api/auth/login route returns a clear "use Google" 400 if
  // a user with passwordHash=null tries to sign in via the password form.
  passwordHash        String?
  emailVerified       Boolean              @default(false)
  emailVerifyToken    String?
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  // phoneToken — relay/WS auth bearer used by the Android APK.
  //
  // Bundle A (2026-05-28) Phase 4 fix (C2):
  // The `cuid()` default was a non-cryptographic 25-char ID — predictable in
  // structure, generated as User.phoneToken regardless of context. Now: NO db
  // default; every app-code site that creates a User must explicitly populate
  // phoneToken with `crypto.randomBytes(32).toString('base64url')` (≈43 chars
  // of entropy, base64url-safe so it survives URL/query encoding).
  //
  // The accompanying migration (`phoneToken_random_default`) drops the SQL
  // DEFAULT clause AND rotates every existing row's phoneToken to a fresh
  // crypto-random value — invalidating every v29 APK token in one shot.
  // Dennis (the only paying user) re-pairs via /api/auth/apk-login. Once
  // Bundle C v30 lands the APK switches to relay-ticket and the legacy
  // ?token= path can be deprecated.
  phoneToken          String               @unique // set in app code, never via @default
  // sessionVersion — monotonic counter, bumped on every successful login.
  // JWTs are signed with the post-bump value in their `ver` claim. Any token
  // whose `ver` no longer matches the DB column is rejected → effectively a
  // single-active-session policy (dispatch #27, 2026-05-24, Option III).
  sessionVersion      Int                  @default(0)
  // Google OAuth (dispatch #36, 2026-05-25).
  // googleId      — Google's stable user identifier (the `sub` claim from the
  //                 ID token). Nullable for legacy email/password-only users.
  //                 @unique enforces one Google identity per app account.
  // authProvider  — 'email' | 'google' | 'both'. Drives UX hints and the
  //                 lib/auth login path. 'both' = the user signed up one way
  //                 and later linked the other on the same email.
  googleId            String?              @unique
  authProvider        String               @default("email")
  // isAdmin (2026-06-09). Sole-admin flag. ADDITIVE, non-breaking: default
  // false so every existing + future row is a non-admin unless explicitly
  // promoted. Currently TRUE for exactly one account (dennis.kotlenko@gmail.com)
  // — set via a one-off prod UPDATE, NOT seeded in code. Coolify's pre-deploy
  // `prisma db push` applies this column cleanly (adds a NOT NULL column with a
  // default, no data loss). Gate any admin-only feature/route on this flag.
  isAdmin             Boolean              @default(false)
  // IP tracking + same-IP abuse flagging (2026-07-03, dispatch forge/trial-lock
  // -and-admin-dashboard). ALL nullable/additive — Coolify's pre-deploy
  // `prisma db push` adds them cleanly with zero data loss (no NOT NULL without
  // default, no drop). Trust model for the captured IP: see lib/ip.ts.
  //   signupIp     — client IP at account-create time. Basis of the same-IP
  //                  cluster count in GET /api/admin/customers. Never used to
  //                  auto-ban; flag-only for Dennis to review.
  //   lastLoginIp  — client IP at the most recent interactive login.
  //   lastActiveAt — timestamp of the most recent interactive login (proxy for
  //                  "last seen"; NOT bumped on every request, only on login).
  signupIp            String?
  lastLoginIp         String?
  lastActiveAt        DateTime?
  subscription        Subscription?
  // Message templates (Item C1, 2026-05-27). Per-user reusable SMS bodies that
  // previously lived ONLY in browser localStorage (key `dnkdialer_templates`) and
  // were wiped on cache clear. Now persisted server-side, capped at 15/user
  // (enforced in app/api/templates). onDelete: Cascade so deleting a user removes
  // their templates.
  templates           Template[]
  // Quick-reply templates (2026-06-03, dispatch CC-quickreply-templates-v2).
  // SEPARATE store from the normal SMS templates above. Hard-capped at 5/user
  // (enforced in app/api/quick-replies POST → 409). Used ONLY for the
  // reply-and-hangup chips on an incoming call — never general SMS, never
  // surfaced in the normal templates list or composer. onDelete: Cascade.
  quickReplyTemplates QuickReplyTemplate[]
  // whopUserId (2026-08-12, dispatch fix/whop-payment-reconcile). Nullable +
  // indexed, NOT unique → `prisma db push` additive, zero data loss, and a
  // duplicate can never block a signup or a webhook.
  //
  // WHY: Whop's modern v1 webhook Membership payload is SLIM — it carries
  // `user_id` but no user object and therefore NO email. Matching a payment to
  // an account by email alone breaks the moment the payload omits it, or the
  // moment either side changes the email. This column is the DURABLE link:
  // written the first time we successfully match a Whop user to an account
  // (from any rung of the resolution ladder), then preferred over email on
  // every later event. See lib/whop-resolve.ts.
  whopUserId          String?
  // invitedBy (2026-08-15, dispatch forge/admin-create-account). Email of the
  // admin who provisioned this account via POST /api/admin/users. NULL for every
  // self-serve (Google / legacy email) account — additive, zero data loss.
  //
  // Load-bearing, not decorative: `isEmailAllowed` (lib/auth.ts) closes LOGIN to
  // everyone outside AUTH_ALLOWLIST while WAITLIST_MODE is on (the fail-safe
  // default). Without this column an admin-minted account could set its password
  // once and then be locked out of every subsequent login — the invite would be
  // a dead end. An admin explicitly vouching for an email IS the allowlist
  // decision, so /api/auth/login treats a non-null invitedBy as satisfying the
  // auth allowlist. It grants NO entitlement: billing is still decided solely by
  // the shared entitlement core (subscription / free-access / admin), so this is
  // NOT a fourth admit path.
  invitedBy           String?
  // name (2026-08-15, same dispatch). Optional display name. The User model had
  // no name column at all — Google signups never captured one and the admin
  // panel lists accounts by email. An admin creating an account by hand usually
  // knows who it is for, and the invite email reads far less like phishing when
  // it can open with a name. Nullable → additive, zero data loss, and every
  // existing row stays valid.
  name                String?

  @@index([whopUserId])
  // Set-password / reset tokens are looked up BY TOKEN HASH (see
  // lib/passwordSetToken.ts). Without this index that lookup is a full table
  // scan on every invite redemption.
  @@index([resetToken])
}

// Template (Item C1, 2026-05-27). One reusable SMS body per row, owned by a User.
// Hard cap of 15 per user is enforced in the POST /api/templates handler (count
// check → 409), NOT by a DB constraint. sortOrder persists the Dashboard
// TemplatesCarousel drag-to-reorder; list endpoint returns sortOrder ASC,
// createdAt DESC. body/name are unbounded String → Postgres text (multiline,
// \n preserved).
model Template {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  body      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// QuickReplyTemplate (2026-06-03, dispatch CC-quickreply-templates-v2).
// SEPARATE entity from Template — Dennis-locked: "we gotta separate them
// though." One quick-reply per row, owned by a User. MAX 5 per user; enforced
// in the POST /api/quick-replies handler (count → 409), NOT a DB constraint
// (matches Template-cap pattern so it can change without a migration).
// Only used for reply-and-hangup on incoming calls; never general SMS, never
// in the normal templates list or composer.
//   body  — the SMS text sent when the chip is tapped (required).
//   label — optional short display label; if null/empty, UI falls back to body.
//   sortOrder — stable chip order; list endpoint returns sortOrder ASC, createdAt DESC.
model QuickReplyTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Waitlist (2026-06-15, dispatch forge/waitlist-and-auth-allowlist). Email
// capture for the public landing page while the app is pre-Play-Store. ADDITIVE
// and fully isolated — no relation to User/Subscription, so Coolify's pre-deploy
// `prisma db push` applies it cleanly (new table only, zero data loss, no FK).
//   email  — @unique so re-submits dedupe at the DB level; the POST handler
//            treats a unique-collision as success (alreadyOnList), never an error.
//   source — optional attribution tag ('landing' etc.) for future analytics.
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

// FreeAccessEmail (2026-07-30, dispatch forge/admin-panel-free-access). The
// email-keyed allowlist that backs Dennis's "grant free access" admin control.
// EMAIL-KEYED (not a User boolean) on purpose: an admin can pre-grant an email
// that has NO account row yet — checked at entitlement-eval time by email. A
// row here → the entitlement gate resolves that email to state 'free_access' →
// Pro tier (see lib/entitlement-core.js). Fully additive & isolated (no FK), so
// Coolify's pre-deploy `prisma db push` applies it cleanly (new table only,
// zero data loss) — same house pattern as Waitlist.
//   email     — @unique, stored LOWERCASED by the API. Both "grant a user free
//               access" and "add an email to the free list" are the SAME upsert
//               keyed here, so a duplicate grant is idempotent at the DB level.
//   note      — optional human reason ("beta tester", "friend").
//   grantedBy — the admin email that created the grant (always Dennis today) —
//               the standing audit field for an active grant.
//   createdAt — when the grant was made ("granted at"). Exposed as `grantedAt`
//               in the admin API.
model FreeAccessEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?
  grantedBy String
  createdAt DateTime @default(now())
}

// FreeAccessAudit (2026-07-30). Append-only audit trail for the free-access
// billing bypass. Because a REVOKE deletes the FreeAccessEmail row, the row
// itself cannot be the audit record for revokes — this table captures every
// grant AND revoke (who/when/what) durably. Never updated, never deleted by app
// code. Additive/isolated → `prisma db push` clean.
//   action — 'grant' | 'revoke'.
//   email  — the target email (lowercased).
//   actor  — admin email that performed the action.
//   note   — optional note supplied on grant (null on revoke).
model FreeAccessAudit {
  id        String   @id @default(cuid())
  action    String
  email     String
  actor     String
  note      String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// AdminUserAudit (2026-08-15, dispatch forge/admin-create-account). Append-only
// trail for admin-initiated ACCOUNT-LIFECYCLE actions. Deliberately a SEPARATE
// table from FreeAccessAudit rather than a new `action` value on it:
//   • FreeAccessAudit answers "who was comped, by whom, when" — its indexes and
//     its every consumer assume every row is a billing-bypass event. Minting an
//     account is not one.
//   • An append-only ledger means the verb chosen today is the verb those rows
//     carry forever; history cannot be relabelled. `user_create` deserves to be
//     its own verb, not folded into a free-access grant.
// A create WITH freeAccess:true therefore writes BOTH: one row here (the account
// was minted) and one FreeAccessAudit `grant` row (the bypass was granted).
// Never updated, never deleted by app code. Additive/isolated → `db push` clean.
//   action     — 'user_create' (the only verb today; more may follow).
//   email      — the target account email (lowercased).
//   actor      — admin email that performed the action.
//   targetId   — the created User.id, so the trail survives an email change.
//   freeAccess — whether the same request also granted the free-access bypass.
//   note       — optional admin note.
model AdminUserAudit {
  id         String   @id @default(cuid())
  action     String
  email      String
  actor      String
  targetId   String?
  freeAccess Boolean  @default(false)
  note       String?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  whopMembershipId      String?
  // trial | active | expired | cancelled
  //   'cancelled' — the sub ended AFTER the customer cancelled (we saw
  //                 cancelAtPeriodEnd, or a cancellation event, first).
  //   'expired'   — the sub ended with no recorded cancellation (involuntary
  //                 churn: failed payment, chargeback, admin revoke).
  // Both are non-entitled and take the SAME deny branch in
  // lib/entitlement-core.js rule (7) — the distinction is commercial reporting
  // (voluntary vs involuntary churn), never access. Until 2026-08-11 the
  // webhook wrote 'expired' for BOTH and 'cancelled' was never written despite
  // being documented here.
  status                String    @default("trial")
  trialEndsAt           DateTime
  currentPeriodEnd      DateTime?
  // Customer-tracking columns (2026-07-03, dispatch forge/trial-lock-and-admin
  // -dashboard). ALL nullable/defaulted → `prisma db push` additive, zero data
  // loss.
  //   convertedAt          — the moment this sub FIRST transitioned to 'active'
  //                          (= "paying since"). Set once by the Whop webhook
  //                          when convertedAt is still null; never overwritten.
  //                          Historical rows stay null (UI shows "—").
  //   paymentMethodAttached— best-effort "card on file". v1: true once status
  //                          is 'active'. See Whop webhook route + report note
  //                          re: confirming card-on-file during trial via Whop
  //                          API.
  //   canceledAt           — the moment we FIRST learned this sub was
  //                          cancelled. Stamped ONCE (only written while still
  //                          null) so a mid-period cancellation records the
  //                          REQUEST time and the later went_invalid does not
  //                          overwrite it with the lapse time. null while
  //                          active/trial.
  convertedAt           DateTime?
  paymentMethodAttached Boolean   @default(false)
  canceledAt            DateTime?
  // cancelAtPeriodEnd (2026-08-11, dispatch forge/whop-payment-tracking-admin).
  // Boolean @default(false) → `prisma db push` additive, zero data loss.
  //
  // WHY: when a customer cancels mid-period Whop keeps the membership VALID and
  // only flips `cancel_at_period_end` on the membership object — no
  // membership.went_invalid fires until the paid period actually lapses.
  // Without this column such a customer reads as a happy "Paying" row right up
  // until they silently vanish. true = "cancelled, but still entitled until
  // currentPeriodEnd" — a churn signal, NOT a lockout.
  //
  // ENTITLEMENT DELIBERATELY IGNORES IT: lib/entitlement-core.js never reads
  // this column. A cancelled-but-paid-through customer keeps full access until
  // currentPeriodEnd, which is exactly what they bought. Reporting only.
  cancelAtPeriodEnd     Boolean   @default(false)
  // Whop plan id → billing tier (2026-07-27, dispatch feature/tier-gating).
  // Nullable & un-defaulted → `prisma db push` additive, zero data loss. The
  // Whop webhook persists extractPlanId(data) on every upsert going forward.
  //   BACKFILL RULE: planId == null → Solo tier. Correct and safe — every
  //   paying customer to date bought the single $5 plan (plan_CGlYdJJr3Btlu),
  //   so null maps to Solo with zero risk of over-granting. Tier resolution
  //   lives in lib/tiers-core.js (planIdToTier: null/unknown → 'solo'); this
  //   column is the raw input, never the resolved tier.
  planId                String?
  // Failed-payment tracking (2026-08-12, dispatch fix/whop-payment-reconcile).
  // Nullable / defaulted → `prisma db push` additive, zero data loss.
  //
  // ENTITLEMENT DELIBERATELY IGNORES BOTH. A single failed charge must NOT
  // revoke access — Whop retries dunning for days and the customer may simply
  // have a expired card. `membership.went_invalid` remains the ONLY revocation
  // signal. These columns exist so a failing customer is VISIBLE before they
  // churn, which is the whole point of the incident this dispatch closes.
  //   lastPaymentFailedAt  — most recent payment.failed event.
  //   paymentFailureCount  — consecutive failures; reset to 0 on any success.
  lastPaymentFailedAt   DateTime?
  paymentFailureCount   Int       @default(0)
  // grandfathered (2026-08-17, dispatch forge/pricing-trial-limited).
  // Boolean @default(false) → additive `prisma migrate deploy`, zero data loss.
  //
  // THE PRICING SWITCH. On 2026-08-17 the plans were re-shaped: $5 became the
  // only promoted plan (7 tpl / 3 qr / 3mo sync), $7 the hidden upgrade, and the
  // free trial became FEATURE-LIMITED (1 tpl / 0 qr / 3d sync) — where before a
  // trial silently granted its plan's full tier. To avoid changing terms under
  // anyone who already signed up, the migration sets grandfathered = true on
  // EVERY row that existed at launch. New self-serve rows default false.
  //
  // ENTITLEMENT READS IT (unlike the reporting-only columns above): lib/
  // entitlement-core.js resolveTier/withTier branch on this flag —
  //   true  → the FROZEN pre-launch maps (prior caps + "trial === full tier").
  //   false → the NEW maps (limited trial + re-pointed $5/$7 caps).
  // It NEVER changes `allowed` (the paywall) — only which limit-set world
  // applies. The Whop webhook does not touch it, so a grandfathered trial that
  // converts to active stays grandfathered forever.
  grandfathered         Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // whopMembershipId was neither unique nor indexed until 2026-08-12 — every
  // webhook that fell back to the membership-id rung did a SEQUENTIAL SCAN.
  // Indexed, NOT unique: Whop legitimately issues a customer several
  // memberships (trial + real subscription), and a unique constraint would
  // make the webhook throw mid-payment rather than simply re-point the row.
  @@index([whopMembershipId])
}

/**
 * UnmatchedWhopEvent (2026-08-12, dispatch fix/whop-payment-reconcile).
 * A signed, verified Whop event we could NOT attach to an app account. Before
 * this table those events returned a bare `{ok:true}` and vanished: Whop saw
 * success, nobody was alerted, and a paying customer stayed invisible until he
 * complained. That silence is what turned a match failure into an unnoticed
 * revenue incident on 2026-08-11.
 * We still answer 200 (a non-2xx would make Whop retry-storm on an event we
 * genuinely cannot process yet — e.g. the customer pays BEFORE registering),
 * but the evidence is now durable and replayable: `rawPayload` holds the whole
 * verified event, so reconciliation or a manual fix can resolve it later and
 * stamp resolvedUserId/resolvedAt.
 * Contains customer PII (email) by design — it is the recovery key. Same
 * retention posture as the User table.
 */
model UnmatchedWhopEvent {
  id               String    @id @default(cuid())
  eventName        String
  whopMembershipId String?
  whopUserId       String?
  payloadEmail     String?
  rawPayload       Json
  // Filled in when the event is later attached to an account (reconciliation
  // or a manual fix). Null = still unresolved = still needs attention.
  resolvedUserId   String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([resolvedAt])
  @@index([whopUserId])
  @@index([payloadEmail])
}

// -- Article -- the /guides CMS (dispatch feat/articles-cms-backend, 2026-08-12)
//
// WHY A TABLE AT ALL: the 17 guides used to live ONLY as Markdown files in
// content/guides/ and were read off disk at BUILD time. Publishing an edit
// therefore cost a full Coolify container rebuild (minutes) and made the CMS
// depend on CI being healthy. Articles now live here; /guides reads the DB with
// ISR (revalidate 300) and the admin publish action calls revalidatePath(), so
// a publish is live in seconds with no deploy.
//
// FILES ARE NOT DELETED. content/guides/*.md and lib/guides.ts remain as the
// SEED SOURCE and -- critically -- as the FALLBACK: lib/articles.ts serves the
// file-based guides whenever this table is empty or the query throws. These are
// 17 live SEO pages; a bad migration must never be able to blank /guides.
//
// status is a plain String, not a Postgres enum, on purpose: adding a future
// state ('scheduled', 'archived') to an enum needs a DDL migration, and an enum
// value cannot be resolved inside a prepared IN-list without being registered
// first. Only 'draft' | 'published' are written; every read filters on the
// literal 'published'.
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String    @default("")
  // Markdown, frontmatter already stripped. Rendered on a PUBLIC page by
  // react-markdown WITHOUT rehype-raw, so embedded HTML is escaped and never
  // executed. See app/guides/[slug]/page.tsx for the full invariant note.
  body        String
  keywords    String[]
  status      String    @default("draft")
  // Stamped once, on the FIRST publish, and preserved across
  // unpublish -> republish so the article keeps its original publication date
  // (its SEO datePublished and sitemap lastModified do not churn).
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Admin email of the last human editor. Also the seed script's idempotency
  // guard: a row with updatedBy set has been touched in the admin and is NEVER
  // overwritten by a re-run of scripts/seed-articles-from-files.mjs.
  updatedBy   String?

  // Covers the only hot read path: published articles, newest first.
  @@index([status, publishedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SDK-PKG-2 Phase 1 (feat/partner-api-keys, 2026-08-25) — per-company API keys.
//
// Until now the server-to-server relay-ticket mint authenticated ONE shared
// `CC_M2M_MINT_KEY` (env) that our own dnk-crm holds. To SELL ComputerCaller as
// an SDK to outside companies we need real per-partner credentials: each partner
// gets its own hashed key, its own scopes, and its own rate limit — issuable and
// revocable without touching env or redeploying.
//
// TRUST MODEL (Phase 1): a partner key authenticates the CALLER (the company).
// The partner is trusted to pass only ccUserIds it manages — the SAME trust
// dnk-crm has today. Per-user consent binding (proving a ccUserId authorized
// THIS partner) is Phase-2 OAuth and is deliberately NOT modelled here.
//
// The entitlement gate (evaluateUserEntitlement) is UNCHANGED and still gates
// the TARGET user — a partner key never bypasses the paywall.
// ─────────────────────────────────────────────────────────────────────────────

// A company that has bought SDK access. Identified by a stable slug; may hold
// many API keys (issue a new one, revoke the old — key rotation without losing
// the partner's identity, scopes history, or plan).
model Partner {
  id        String   @id @default(cuid())
  name      String
  // URL/log-safe stable handle, unique. Used in audit lines + admin display.
  slug      String   @unique
  // 'active' | 'suspended'. A suspended partner's keys all fail closed at auth
  // time regardless of individual key status (org-level kill switch).
  status    String   @default("active")
  // Nullable free-text plan tag ("starter"/"pro"/…). Carries future per-seat
  // billing metadata; NOT read by the auth path in Phase 1.
  plan      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiKeys PartnerApiKey[]

  @@index([status])
}

// One issued API key for a Partner. The plaintext secret is shown ONCE at
// issuance and NEVER stored — only a SHA-256 hash of the secret is persisted.
//
// Key material handed to the partner:  ccp_live_<keyId>.<secret>
//   • keyId  — public, non-secret, indexed lookup handle + display prefix.
//   • secret — 32 random bytes (base64url). Hashed on write, constant-time
//              compared on read. `.` is not in the base64url alphabet, so it is
//              an unambiguous separator between keyId and secret.
model PartnerApiKey {
  id              String    @id @default(cuid())
  partnerId       String
  partner         Partner   @relation(fields: [partnerId], references: [id])
  // Public identifier parsed from the presented key and used for the DB lookup
  // BEFORE any secret compare. Non-secret by design; safe to display/log.
  keyId           String    @unique
  // SHA-256(secret) hex. NEVER the plaintext. The secret has >=256 bits of
  // entropy (crypto.randomBytes(32)), so a fast cryptographic hash is the right
  // tool — it is not a low-entropy password, so argon2/bcrypt work-factor cost
  // (which would tax every mint) buys nothing here. Constant-time compared.
  hashedSecret    String
  // Capabilities this key may exercise, server-enforced. Phase-1 vocabulary:
  //   'call'       — mint a relay-ticket (precursor to placing a call).
  //   'presence'   — (reserved) presence/status reads.
  //   'read_logs'  — (reserved) call-log reads.
  //   'sms'        — (reserved) future SMS. Not honoured yet.
  scopes          String[]  @default([])
  // 'active' | 'revoked'. A revoked key fails auth closed (opaque 401).
  status          String    @default("active")
  // Per-partner-key sliding-window limit (mints/min). NULL → server default.
  rateLimitPerMin Int?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@index([partnerId])
  @@index([status])
}
