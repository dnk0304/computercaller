# Image for both cc-e2e-soak-relay and cc-e2e-soak-runner.
#
# ONE image for both on purpose: the runner must hold the pairs using the same
# ws client, the same node version and the same lib/e2e code as the relay it is
# measuring. A runner built from a different base is a second variable in an
# experiment that is supposed to have one.
#
# Built from THIS tree (branch e2e/soak-rig off 392e490 — the tree D1 ships,
# per R-AM), because the Hetzner host has no GitHub access: the image must be
# buildable from the checkout that is copied to it. Pass the sha at build time
# so the running container can name the commit it is evidence about — a soak
# trace that cannot name its build is not evidence.
FROM node:22-bookworm-slim

ARG SOAK_SHA=unset
ENV SOAK_SHA=${SOAK_SHA}

# `tee` for the N-2 stdout capture, openssl for prisma.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates coreutils \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies first so a code-only change does not re-resolve the tree.
COPY package.json package-lock.json ./
COPY prisma ./prisma
# devDependencies ARE INSTALLED, deliberately. `npm run build` is `next build`,
# and typescript, @types/*, tailwindcss and @tailwindcss/postcss all live in
# devDependencies — the previous `npm install --omit=dev` here could never have
# reached a successful build, which is one of the two reasons Ken's soak
# pre-flight failed. Image size is not the constraint on a scratch soak box;
# a stack that cannot build is.
#
# `npm ci` rather than `npm install` so the image resolves the committed
# package-lock.json instead of whatever npm decides today — a soak of a
# different dependency tree is evidence about a different build. `postinstall`
# in package.json runs `prisma generate`, so the client is generated here.
RUN npm ci --no-audit --no-fund

COPY . .

# The relay runs NODE_ENV=production, which needs a real build. Doing it here
# rather than at container start means the 24 h window is not spent compiling,
# and means a build failure is a BUILD failure rather than a soak that quietly
# never started.
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Evidence lives on a volume mounted here. Declared so a run without the volume
# still writes somewhere rather than failing at the first heartbeat.
RUN mkdir -p /evidence
VOLUME ["/evidence"]

EXPOSE 3000

# No CMD: docker-compose.soak.yml gives each service its own command, and a
# default here would let the wrong one start silently if a service ever lost
# its command line.
