<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ANDROID-LINT-2 (Pilot R-AZ) — telephony vs camera uses-feature.

      CALL_PHONE / SEND_SMS / RECEIVE_SMS / READ_SMS each imply
      <uses-feature android:name="android.hardware.telephony" android:required="true"/>.
      That implication STAYS: telephony is required. The Play device list must
      remain exactly what the live listing already has. Shipping to Chromebooks
      Wi-Fi tablets and radio-less devices would put the dialer/SMS surfaces on
      hardware where they are inert — the "unable to verify core functionality"
      path of the June 2026 SMS/Call-Log rejection. No required="false" line for
      telephony; the implicit required="true" is the declaration.

      CAMERA is different: it is only used for QR pairing, and pairing has a
      non-QR fallback, so android.hardware.camera is declared required="false".

      The resulting PermissionImpliesUnsupportedChromeOsHardware lint warning on
      the four telephony permissions is suppressed per-permission via
      tools:ignore (never at the manifest root, which would mask the check for
      any permission added later).
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Phone permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>

    <!-- SMS permissions -->
    <uses-permission android:name="android.permission.SEND_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>
    <uses-permission android:name="android.permission.READ_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>

    <!-- Contacts permission -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Camera permission for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Network permission -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!--
      Bluetooth permissions (2-mode audio routing — dispatch 2026-05-25).
      Two SDK tiers because Google split BT manifest perms at API 31.

      Pre-API 31 (Android 11 and below):
        BLUETOOTH        — required to connect to / interact with an already-
                           paired BT-HFP headset (i.e. read connection state).
        BLUETOOTH_ADMIN  — required for SCO management (startBluetoothSco etc.).
      Both are declared with maxSdkVersion="30" so they don't fight with the
      new runtime-grant model on 31+.

      API 31+ (Android 12 onwards):
        BLUETOOTH_CONNECT — runtime grant. Required to (a) call
                            BluetoothAdapter.getProfileProxy / register
                            BluetoothHeadset state listeners, and (b) read
                            BluetoothDevice.getName() so we can show the
                            user "Connected to <device>" in the UI.

      The app does NOT scan / pair BT devices itself — Dennis pairs his PC
      via the system Settings, then our service just observes the resulting
      HFP profile state and routes call audio over the SCO channel. So
      BLUETOOTH_SCAN is intentionally NOT declared (would require additional
      runtime grant + neverForLocation flag for no functional gain).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <!-- Battery optimization exclusion -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:name=".CompanionApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:autoRevokePermissions="disallowed"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DNKDialerCompanion"
        tools:targetApi="31">

        <!--
          Bug #3 dispatch #23 — Android 11+ auto-revokes runtime permissions
          for apps the user "hasn't used recently". For a phone-bridge
          background service the user almost never opens the app's
          foreground UI; the bridge runs as a foreground service. That makes
          us a textbook auto-revoke victim.

          android:autoRevokePermissions="disallowed" (introduced API 31, but
          honored by the framework's auto-revoke flow on API 30 too) asks
          the OS to keep our grants UNLESS the user explicitly disables
          auto-revoke in our app's settings — which means the OS will surface
          a request the first time it would have auto-revoked, rather than
          silently nuking call/SMS/contacts permissions.

          PermissionChecker.kt has a paired runtime check
          (shouldShowAutoRevokeWarning — backed by
          androidx.core.content.PackageManagerCompat
          .getUnusedAppRestrictionsStatus since dispatch #25 v15) that
          detects when the OS has flipped us back to auto-revoking and
          re-routes the user to the auto-revoke deep-link before we hit
          the resulting permission losses.
        -->


        <!--
          v56 - launchMode=singleTop so the connection-request notification's
          content intent (FLAG_ACTIVITY_CLEAR_TOP) is delivered to the LIVE
          instance via onNewIntent instead of destroying + recreating it.
          Without it, CLEAR_TOP on a standard-mode activity recreates the
          Activity and the in-flight pairing dialog state is lost.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Dispatch #28 (2026-05-24) — first-launch sign-in.
          Not exported (no external entry point) and not declared in the
          LAUNCHER intent-filter; MainActivity launches it via explicit
          Intent when TokenStore.hasToken() returns false.
        -->
        <activity
            android:name=".SignInActivity"
            android:exported="false" />

        <!--
          Play verifiability fix (v40, 2026-06-21) — on-device viewer of the
          synced SMS + call log. Reachable from MainActivity so a Play
          reviewer with ONE phone can SEE the restricted-permission feature
          (READ_SMS / READ_CALL_LOG) exercise on the device alone, no desktop
          pairing. Not exported; launched via explicit Intent only.
        -->
        <activity
            android:name=".SyncedDataActivity"
            android:exported="false" />

        <!--
          v56 - dedicated Settings screen. Everything that used to live at
          the bottom of Home (sign out, permissions, notification access,
          synced viewers, lobby toggle, hard reset) moved here so Home is
          just presence + the primary action. Not exported; launched via
          explicit Intent from MainActivity only.
        -->
        <!--
          FT-2 (v59) — file transfer. ONE activity, transparent, finishes as
          soon as its dialog or SAF picker resolves.

          exported="true" is required and is the whole point: the ACTION_SEND
          filter is the "Send to computer" share-sheet target. It is also the
          only externally reachable entry point this feature adds, and it can
          do exactly one thing — show a confirm dialog for a URI the SENDING
          app already granted us. It cannot accept an incoming offer (that
          path reads the service's own pending offer, not the intent) and it
          cannot cancel a transfer (that is FileTransferActionReceiver, which
          is registered at runtime with RECEIVER_NOT_EXPORTED).

          excludeFromRecents (and NOT noHistory): a dialog that survives in
          the recents list can be resumed long after its transfer is gone, and
          excludeFromRecents alone is what keeps it out of recents. noHistory
          was here until vc64 and was the bug: it destroys the activity the
          moment it stops being visible, which is exactly what opening a SAF
          picker does - so onActivityResult never ran, send never started and
          an incoming offer could never be given a destination (proven on PROD
          by ACCEPT-9, 2026-09-23). "No zombie dialog" is carried instead by
          the finish() on every exit path of every dialog in the activity.

          NO new permission and NO new foreground-service type: transfers run
          inside the existing specialUse FGS's lifetime (spec §3), which is
          what keeps the dataSync 6-hour cap and a fresh Play declaration out
          of this build.
        -->
        <activity
            android:name=".FileTransferActivity"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog.Alert"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter android:label="@string/ft_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/ft_share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <!--
          vc65 - Settings > Permissions. The live permission checklist
          (the same one the first-run pane shows) with a tap target per
          row into the matching OS settings page. Navigation only: it
          requests no permission and declares none, so this <activity>
          element is the whole manifest diff for that lane.
        -->
        <activity
            android:name=".PermissionsActivity"
            android:label="@string/permissions_title"
            android:parentActivityName=".SettingsActivity"
            android:exported="false" />

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SmsStatusReceiver"
            android:exported="false" />

        <service
            android:name=".PhoneService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Phone call and messaging bridge service" />
        </service>

        <!--
          T-VC63-EXPORT-DIAGNOSTICS (vc63) — the app's FIRST FileProvider.

          It exists for exactly one thing: handing a diagnostics zip to the
          share sheet the user just chose a target in. Everything about the
          declaration is the minimum that allows that:

            exported="false"        — no other app can address the provider.
            grantUriPermissions     — a grant is the ONLY way in, and every
                                      grant is made by DiagExport.shareIntent
                                      with FLAG_GRANT_READ_URI_PERMISSION on a
                                      single file uri.
            authority .diagnostics  — namespaced under applicationId so debug
                                      and release installs can coexist.
            @xml/diag_paths         — cacheDir/diag-export/ and nothing else.

          The scope matters more here than in most apps: this process can read
          SMS, the call log, contacts and the E2E device key. A provider rooted
          at cacheDir (let alone filesDir) would make a share-sheet tap the
          weakest link in all of that. See res/xml/diag_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diag_paths" />
        </provider>

        <service
            android:name=".DnkNotificationListenerService"
            android:label="ComputerCaller Notifications"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>

