<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ANDROID-LINT (b3) — PermissionImpliesUnsupportedChromeOsHardware x5.

      CALL_PHONE / SEND_SMS / RECEIVE_SMS / READ_SMS each IMPLY
      <uses-feature android:name="android.hardware.telephony" android:required="true"/>
      and CAMERA implies android.hardware.camera required="true", unless the
      manifest says otherwise. That implicit "required" is a DISTRIBUTION rule,
      not a runtime one: Play filters the listing to devices that have the
      hardware, so today this app is invisible to Chromebooks, Wi-Fi tablets
      and any device without a radio.

      Declaring required="false" WIDENS eligibility — it never narrows it — and
      it is the honest declaration for this app: the companion pairs with a
      phone and its call/SMS surfaces already degrade gracefully when the
      platform refuses (CallHandler returns false, the UI reports it). A device
      without a radio gets the paired-dialer surfaces and not the local ones.
      PILOT NOTE: this changes the Play device list (more devices, none
      removed). Nothing else about the listing, permissions or policy moves.
    -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Phone permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>

    <!-- SMS permissions -->
    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>

    <!-- Contacts permission -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Camera permission for QR scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Network permission -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!--
      Bluetooth permissions (2-mode audio routing — dispatch 2026-05-25).
      Two SDK tiers because Google split BT manifest perms at API 31.

      Pre-API 31 (Android 11 and below):
        BLUETOOTH        — required to connect to / interact with an already-
                           paired BT-HFP headset (i.e. read connection state).
        BLUETOOTH_ADMIN  — required for SCO management (startBluetoothSco etc.).
      Both are declared with maxSdkVersion="30" so they don't fight with the
      new runtime-grant model on 31+.

      API 31+ (Android 12 onwards):
        BLUETOOTH_CONNECT — runtime grant. Required to (a) call
                            BluetoothAdapter.getProfileProxy / register
                            BluetoothHeadset state listeners, and (b) read
                            BluetoothDevice.getName() so we can show the
                            user "Connected to <device>" in the UI.

      The app does NOT scan / pair BT devices itself — Dennis pairs his PC
      via the system Settings, then our service just observes the resulting
      HFP profile state and routes call audio over the SCO channel. So
      BLUETOOTH_SCAN is intentionally NOT declared (would require additional
      runtime grant + neverForLocation flag for no functional gain).
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Foreground service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <!-- Battery optimization exclusion -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
        android:name=".CompanionApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:autoRevokePermissions="disallowed"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DNKDialerCompanion"
        tools:targetApi="31">

        <!--
          Bug #3 dispatch #23 — Android 11+ auto-revokes runtime permissions
          for apps the user "hasn't used recently". For a phone-bridge
          background service the user almost never opens the app's
          foreground UI; the bridge runs as a foreground service. That makes
          us a textbook auto-revoke victim.

          android:autoRevokePermissions="disallowed" (introduced API 31, but
          honored by the framework's auto-revoke flow on API 30 too) asks
          the OS to keep our grants UNLESS the user explicitly disables
          auto-revoke in our app's settings — which means the OS will surface
          a request the first time it would have auto-revoked, rather than
          silently nuking call/SMS/contacts permissions.

          PermissionChecker.kt has a paired runtime check
          (shouldShowAutoRevokeWarning — backed by
          androidx.core.content.PackageManagerCompat
          .getUnusedAppRestrictionsStatus since dispatch #25 v15) that
          detects when the OS has flipped us back to auto-revoking and
          re-routes the user to the auto-revoke deep-link before we hit
          the resulting permission losses.
        -->


        <!--
          v56 - launchMode=singleTop so the connection-request notification's
          content intent (FLAG_ACTIVITY_CLEAR_TOP) is delivered to the LIVE
          instance via onNewIntent instead of destroying + recreating it.
          Without it, CLEAR_TOP on a standard-mode activity recreates the
          Activity and the in-flight pairing dialog state is lost.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Dispatch #28 (2026-05-24) — first-launch sign-in.
          Not exported (no external entry point) and not declared in the
          LAUNCHER intent-filter; MainActivity launches it via explicit
          Intent when TokenStore.hasToken() returns false.
        -->
        <activity
            android:name=".SignInActivity"
            android:exported="false" />

        <!--
          Play verifiability fix (v40, 2026-06-21) — on-device viewer of the
          synced SMS + call log. Reachable from MainActivity so a Play
          reviewer with ONE phone can SEE the restricted-permission feature
          (READ_SMS / READ_CALL_LOG) exercise on the device alone, no desktop
          pairing. Not exported; launched via explicit Intent only.
        -->
        <activity
            android:name=".SyncedDataActivity"
            android:exported="false" />

        <!--
          v56 - dedicated Settings screen. Everything that used to live at
          the bottom of Home (sign out, permissions, notification access,
          synced viewers, lobby toggle, hard reset) moved here so Home is
          just presence + the primary action. Not exported; launched via
          explicit Intent from MainActivity only.
        -->
        <!--
          FT-2 (v59) — file transfer. ONE activity, transparent, finishes as
          soon as its dialog or SAF picker resolves.

          exported="true" is required and is the whole point: the ACTION_SEND
          filter is the "Send to computer" share-sheet target. It is also the
          only externally reachable entry point this feature adds, and it can
          do exactly one thing — show a confirm dialog for a URI the SENDING
          app already granted us. It cannot accept an incoming offer (that
          path reads the service's own pending offer, not the intent) and it
          cannot cancel a transfer (that is FileTransferActionReceiver, which
          is registered at runtime with RECEIVER_NOT_EXPORTED).

          excludeFromRecents + noHistory: a dialog that survives in the recents
          list can be resumed long after its transfer is gone.

          NO new permission and NO new foreground-service type: transfers run
          inside the existing specialUse FGS's lifetime (spec §3), which is
          what keeps the dataSync 6-hour cap and a fresh Play declaration out
          of this build.
        -->
        <activity
            android:name=".FileTransferActivity"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog.Alert"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter android:label="@string/ft_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/ft_share_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity"
            android:exported="false" />

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SmsStatusReceiver"
            android:exported="false" />

        <service
            android:name=".PhoneService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Phone call and messaging bridge service" />
        </service>

        <service
            android:name=".DnkNotificationListenerService"
            android:label="ComputerCaller Notifications"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>

