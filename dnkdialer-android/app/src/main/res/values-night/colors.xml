<?xml version="1.0" encoding="utf-8"?>
<!--
  v56 — DARK token set (DIRECTION-android-v56.md).

  Same names as values/colors.xml; only the values differ, so nothing in a
  layout or drawable needs a qualifier. Pre-v56 these values lived in
  values/ and the app was dark-only; as of v56 the theme is DayNight and
  follows the system (decision 3, approved).

  Only the tokens that CHANGE between modes are listed. The brand ramp
  (cc_brand_*), the QR plate and the Google sign-in branding are fixed in
  both modes and stay in values/.
-->
<resources>
    <!-- Surface scale — page / card / field / hairline. -->
    <color name="surface_base">#0B0B0D</color>
    <color name="surface_raised">#18181B</color>
    <color name="surface_inset">#1F1F23</color>
    <color name="surface_border">#27272A</color>
    <color name="surface_border_strong">#3F3F46</color>

    <!-- Text scale. -->
    <color name="text_primary">#FAFAFA</color>
    <color name="text_secondary">#A3A3A3</color>
    <color name="text_tertiary">#8A8A8A</color>
    <color name="text_label">#8A8A8A</color>

    <!-- Accent. The legacy accent_blue / accent_warm names now resolve to
         the brand ramp's end stop so old references stay on-palette. -->
    <color name="accent_blue">#1E8FB2</color>
    <color name="accent_blue_pressed">#17708C</color>
    <color name="accent_blue_dim">#1F4351</color>
    <color name="accent_cyan">#22A89A</color>
    <color name="accent_warm">#1E8FB2</color>
    <color name="accent_warm_pressed">#17708C</color>
    <color name="accent_warm_dim">#1F4351</color>

    <!-- State. Colour is reserved for state (DIRECTION trait 3). -->
    <color name="dot_live">#34D399</color>
    <color name="dot_live_soft">#34D39940</color>
    <color name="dot_live_glow">#34D39966</color>
    <color name="dot_waiting">#FBBF24</color>
    <color name="dot_waiting_soft">#FBBF2440</color>
    <color name="dot_idle">#3F3F46</color>
    <color name="dot_connecting">#1E8FB2</color>
    <color name="dot_connecting_soft">#1E8FB240</color>
    <color name="dot_failed">#F87171</color>
    <color name="dot_failed_soft">#F8717140</color>

    <!-- Token-input chrome. -->
    <color name="field_surface">#1F1F23</color>
    <color name="field_border">#3F3F46</color>
    <color name="field_border_focused">#1E8FB2</color>
</resources>
