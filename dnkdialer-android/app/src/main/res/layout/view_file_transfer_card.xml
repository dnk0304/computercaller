<?xml version="1.0" encoding="utf-8"?>
<!--
  vc69 — the in-app file-transfer card on Home, directly under the hero card.

  Hidden unless a transfer is running, has just ended, or an offer is waiting
  for an answer. Drawn by FileTransferCard from PhoneService.fileTransferUi -
  the same events that drive the progress notification, never a second count.

  Same surface language as the hero: raised surface + hairline, no elevation.
  Buttons are the hero's pills: outline for Cancel / Decline, brand fill for
  the one positive action (Accept / Open).

  FILE-QUEUE (Ken ADDENDUM 2): the card grew into the queue. ftCardActive is
  the vc69 card, unchanged (active transfer / pending offer, with its own
  terminal hold). ftQueueSection sits under it: summary + Paused/Resume, one
  row per queue item (view_file_queue_row), and the Add-file row. The card is
  visible when EITHER half has something to show.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ftCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_12"
    android:visibility="gone"
    app:cardCornerRadius="@dimen/cc_radius_group"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_raised"
    app:strokeWidth="1dp"
    app:strokeColor="@color/surface_border"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ftCardActive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ftCardHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/cc_text_presence"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                tools:text="@string/ft_card_to_computer" />

            <TextView
                android:id="@+id/ftCardPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:textSize="@dimen/cc_text_presence"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                tools:text="49%" />
        </LinearLayout>

        <TextView
            android:id="@+id/ftCardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="@dimen/cc_text_sub"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="holiday-video-2026.mp4" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ftCardProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:max="100"
            app:indicatorColor="@color/accent_blue"
            app:trackColor="@color/surface_border"
            app:trackThickness="6dp"
            app:trackCornerRadius="3dp"
            tools:progress="49" />

        <TextView
            android:id="@+id/ftCardBytes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:textSize="@dimen/cc_text_foot"
            android:textColor="@color/text_tertiary"
            tools:text="212 MB of 432 MB" />

        <TextView
            android:id="@+id/ftCardMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textSize="@dimen/cc_text_foot"
            android:textColor="@color/text_secondary"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone"
            tools:text="@string/ft_fail_connection" />

        <LinearLayout
            android:id="@+id/ftCardActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ftCardSecondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/cc_pill_height"
                android:text="@string/ft_cancel"
                android:textSize="@dimen/cc_text_button"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_pill_outline"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ftCardPrimary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/cc_pill_height"
                android:layout_marginStart="10dp"
                android:text="@string/ft_card_open"
                android:textSize="@dimen/cc_text_button"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_pill_brand"
                android:stateListAnimator="@null"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ftQueueSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_4"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:id="@+id/ftQueueDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_border" />

        <LinearLayout
            android:id="@+id/ftQueueHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ftQueueSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/cc_text_presence"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:accessibilityLiveRegion="polite"
                tools:text="2 queued" />

            <TextView
                android:id="@+id/ftQueueResume"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/ft_queue_resume"
                android:textSize="@dimen/cc_text_button"
                android:textColor="@color/accent_blue"
                android:fontFamily="sans-serif-medium"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/ftQueuePausedReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_4"
            android:textSize="@dimen/cc_text_foot"
            android:textColor="@color/text_secondary"
            android:visibility="gone"
            tools:text="@string/ft_fail_connection" />

        <LinearLayout
            android:id="@+id/ftQueueRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/ftQueueAdd"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="@string/row_send_file_title"
            android:textSize="@dimen/cc_text_button"
            android:textColor="@color/accent_blue"
            android:fontFamily="sans-serif-medium"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
