<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity: Synced data viewer — Google Play verifiability fix (v40, 2026-06-21).

  WHY THIS SCREEN EXISTS
  Google Play REJECTED the app under the SMS and Call-Log Permissions policy
  ("Unable to verify core functionality"). Root cause (Pilot's diagnosis):
  the restricted-permission use (READ_SMS / RECEIVE_SMS / READ_CALL_LOG) was
  only visible on the DESKTOP web app after pairing a 2nd device. A reviewer
  with ONE phone could not SEE the feature exercise the permission, so the
  perms read as unjustified.

  This screen makes the restricted-permission use visible ON THE PHONE ALONE:
  it reads the device's own SMS (via SmsHandler.getMessages) and call log
  (via CallLogsHandler.getCallLogs) and renders them in-app, with NO desktop
  pairing required. A reviewer grants the permission and immediately sees
  their own messages / calls populate — that grant→populate moment is the
  demonstration the reviewer needs.

  Two tabs (Messages / Call history) toggle a single scroll container whose
  rows are built programmatically in SyncedDataActivity (no RecyclerView /
  adapter — keep the surface tiny and dependency-free; Pixel can polish
  later if dispatched). Function over form, per the brief.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_base">

    <!-- ============ Header: wordmark-ish title + back ============ -->
    <LinearLayout
        android:id="@+id/syncedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_16">

        <TextView
            android:id="@+id/syncedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/synced_title"
            android:textSize="@dimen/text_status"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.015" />

        <Button
            android:id="@+id/syncedBackButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/synced_back"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16" />
    </LinearLayout>

    <!-- ============ Tab row: Messages / Call history ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_12">

        <Button
            android:id="@+id/tabMessages"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_8"
            android:text="@string/synced_tab_messages"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/tabCalls"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/synced_tab_calls"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/surface_border" />

    <!-- ============ Permission-empty state ============ -->
    <!-- Shown when the relevant restricted permission isn't granted yet.
         The "Grant permission" button fires the runtime request; on grant
         the list below populates. This is the single most important moment
         for the reviewer's screen recording. -->
    <LinearLayout
        android:id="@+id/syncedPermissionPane"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_32"
        android:paddingBottom="@dimen/space_32"
        android:visibility="gone">

        <TextView
            android:id="@+id/syncedPermissionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/synced_perm_messages"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:gravity="center_horizontal"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginBottom="@dimen/space_24" />

        <Button
            android:id="@+id/syncedGrantButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/synced_grant"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- ============ Data list (scrolling) ============ -->
    <ScrollView
        android:id="@+id/syncedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/syncedListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_24"
            android:paddingEnd="@dimen/space_24"
            android:paddingTop="@dimen/space_16"
            android:paddingBottom="@dimen/space_32" />
    </ScrollView>

    <!-- Empty-but-permitted state (perms granted, zero rows). Distinct from
         the permission pane above. -->
    <TextView
        android:id="@+id/syncedEmptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/synced_empty_messages"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_tertiary"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingBottom="@dimen/space_32"
        android:visibility="gone" />

</LinearLayout>
