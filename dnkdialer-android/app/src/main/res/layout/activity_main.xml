<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity: Main / control screen — Round 7 (sleek-tech).

  Design changes vs Round 6 (warm-terracotta):
    - Dark palette: near-black canvas, electric blue accent, emerald
      LIVE dot retained. The whole screen reads as "modern pro tool"
      (Linear / Vercel / Claude.ai), not "friendly companion app".
    - Status dot now sits inside a FrameLayout with a 22dp soft glow
      ring behind it. The ring is GONE in IDLE, faded soft-emerald in
      LIVE, soft-amber in WAITING, soft-blue in CONNECTING. Animation
      logic in MainActivity.setStatusVisual() drives the alpha pulse.
    - Section gutters tightened 28→20 / 32→24 — denser, more pro.
    - QR plate is pure white (best for scanners + max contrast).
    - Wordmark stays sans-serif-black at 42sp with the gradient
      underline.

  Vertical stack inside ScrollView so small phones can reach the bottom.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_32"
        android:paddingBottom="@dimen/space_32">

        <!-- ============ 1. Wordmark + status row ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="@dimen/text_wordmark"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.035"
            android:lineSpacingMultiplier="0.95"
            android:includeFontPadding="false" />

        <!-- Electric blue → cyan gradient underline. -->
        <View
            android:layout_width="@dimen/wordmark_underline_width"
            android:layout_height="@dimen/wordmark_underline_height"
            android:background="@drawable/bg_accent_underline"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_20" />

        <!-- Status row — DOT + RING + short label. gravity=center_vertical
             aligns the FrameLayout midpoint with the text cap-height. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Dot + ring stack. FrameLayout sizes to dot_ring_size; the
                 ring sits at the back, the dot is centered on top. Both
                 are tinted at runtime via setStatusVisual().

                 The ring's alpha is 0 in IDLE and 1 in LIVE/WAITING/
                 CONNECTING — driven from Kotlin so the pulse animation
                 can override it without fighting the XML. -->
            <FrameLayout
                android:layout_width="@dimen/dot_ring_size"
                android:layout_height="@dimen/dot_ring_size"
                android:layout_marginEnd="@dimen/space_12">

                <View
                    android:id="@+id/statusDotRing"
                    android:layout_width="@dimen/dot_ring_size"
                    android:layout_height="@dimen/dot_ring_size"
                    android:layout_gravity="center"
                    android:background="@drawable/status_dot_ring"
                    android:alpha="0"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:layout_gravity="center"
                    android:background="@drawable/status_dot"
                    android:contentDescription="@string/cd_status_dot" />
            </FrameLayout>

            <!-- Short status label — 1–2 words. -->
            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_starting"
                android:textSize="@dimen/text_status"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.015" />

            <!-- Step number — kept invisible (back-compat with the Kotlin
                 setStatusVisual() helper that still references it). -->
            <TextView
                android:id="@+id/stepNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_01"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Connection diagnostic lines (CONNECTING / FAILED phases only). -->
        <TextView
            android:id="@+id/connectionTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:textIsSelectable="true"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone"
            tools:text="Target: ws://192.168.1.136:8765"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/connectionErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/dot_failed"
            android:fontFamily="sans-serif"
            android:textIsSelectable="true"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone"
            tools:text="Couldn't bind to port 8765."
            tools:visibility="visible" />

        <!-- ============ 2. Local address (the URL) ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_address"
            android:textSize="@dimen/text_eyebrow"
            android:textColor="@color/text_label"
            android:textAllCaps="true"
            android:letterSpacing="0.18"
            android:layout_marginTop="@dimen/space_24"
            android:fontFamily="sans-serif-medium" />

        <!-- URL block. Full width. Multi-line wrap. Selectable.
             Now sits inside a hairline-bordered recessed panel with a
             2dp electric-blue left bar. -->
        <TextView
            android:id="@+id/ipText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_loading_ip"
            android:textSize="@dimen/text_url"
            android:textColor="@color/text_primary"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:background="@drawable/bg_url_block"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingTop="@dimen/space_14"
            android:paddingBottom="@dimen/space_14"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.35"
            android:textIsSelectable="true"
            android:layout_marginTop="@dimen/space_8"
            tools:text="ws://192.168.1.42:8765" />

        <Button
            android:id="@+id/copyIpButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/action_copy"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:background="@drawable/bg_button_copy"
            android:stateListAnimator="@null"
            android:letterSpacing="0.04"
            android:layout_marginTop="@dimen/space_8"
            android:contentDescription="@string/action_copy_long" />

        <!-- ============ 3. QR card ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_scan"
            android:textSize="@dimen/text_eyebrow"
            android:textColor="@color/text_label"
            android:textAllCaps="true"
            android:letterSpacing="0.18"
            android:layout_marginTop="@dimen/space_24"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12">

            <ImageView
                android:id="@+id/qrCodeImage"
                android:layout_width="@dimen/qr_size"
                android:layout_height="@dimen/qr_size"
                android:background="@drawable/bg_qr_frame"
                android:padding="@dimen/space_10"
                android:contentDescription="@string/cd_qr" />
        </LinearLayout>

        <!-- ============ 4. Action stack ============ -->
        <Button
            android:id="@+id/reconnectButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/action_reconnect"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_24" />

        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_disconnect"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_8" />

        <Button
            android:id="@+id/enable_notifications_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_enable_notifications"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_warning"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_12" />

    </LinearLayout>
</ScrollView>
