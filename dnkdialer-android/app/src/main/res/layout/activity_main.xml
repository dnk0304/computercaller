<?xml version="1.0" encoding="utf-8"?>
<!--
  Activity: Main / control screen — Round 8 (full-SaaS — dispatch #29 Phase 4 finish).

  Major shift vs Round 7: the phone is no longer a WS server. It connects
  outbound to wss://computercaller.com/relay/phone?token=… so the browser
  finds it via the multi-tenant SaaS relay. No more LAN IP. No more QR
  code. The webapp connects via the same relay using the auth-cookie
  derived token (no manual address entry on either side).

  As a result the layout is dramatically simpler:
    1. Wordmark + gradient underline (unchanged from R7)
    2. Status row (dot + ring + short label) — bound to RelayPhase
       (IDLE / CONNECTING / OPEN / FAILED) and browser-presence count
       via MainActivity.handleRelayPhaseChanged + updateStatus.
    3. Diagnostic lines (CONNECTING / FAILED phases only — masked
       target URL + actionable error copy).
    4. "Enable notifications" button (only shown if system-notifications
       are blocked at OS level for the app).
    5. Sign-out (clears the stored phoneToken, drops the user back at
       SignInActivity).
    6. Hard Reset escape hatch (wipes app data — recovery for the
       Samsung One UI "silently revoked permissions in background" bug
       class). Reads as a quiet ghost action below a hairline divider.

  REMOVED (dispatch #29):
    - ipText  (LAN ws://X:8765 URL display — no LAN listener now)
    - qrCodeImage  (LAN QR for browser scan — webapp uses cookie token)
    - copyIpButton  (copy LAN URL — no URL to copy)
    - label_address + label_scan  (section labels for those blocks)
    - reconnectButton  (was already permanently GONE since dispatch #9)

  Kept the disconnectButton view-id but repurposed as Sign Out (different
  string, same id so the existing Kotlin findViewById still resolves).
  See MainActivity disconnect button handler — rewritten to do the
  Sign Out flow (clear TokenStore + launch SignInActivity + finish()).
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_32"
        android:paddingBottom="@dimen/space_32">

        <!-- ============ 1. Wordmark + gradient underline ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="@dimen/text_wordmark"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.035"
            android:lineSpacingMultiplier="0.95"
            android:includeFontPadding="false" />

        <View
            android:layout_width="@dimen/wordmark_underline_width"
            android:layout_height="@dimen/wordmark_underline_height"
            android:background="@drawable/bg_accent_underline"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginBottom="@dimen/space_24" />

        <!-- ============ 2. Status row ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/dot_ring_size"
                android:layout_height="@dimen/dot_ring_size"
                android:layout_marginEnd="@dimen/space_12">

                <View
                    android:id="@+id/statusDotRing"
                    android:layout_width="@dimen/dot_ring_size"
                    android:layout_height="@dimen/dot_ring_size"
                    android:layout_gravity="center"
                    android:background="@drawable/status_dot_ring"
                    android:alpha="0"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:layout_gravity="center"
                    android:background="@drawable/status_dot"
                    android:contentDescription="@string/cd_status_dot" />
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_starting"
                android:textSize="@dimen/text_status"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.015" />

            <!-- Back-compat — setStatusVisual() still references this id. -->
            <TextView
                android:id="@+id/stepNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_01"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============ 3. Diagnostic lines ============ -->
        <TextView
            android:id="@+id/connectionTargetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:fontFeatureSettings="tnum"
            android:textIsSelectable="true"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_8"
            android:visibility="gone"
            tools:text="Target: wss://computercaller.com/relay/phone?token=abc12345…"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/connectionErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/dot_failed"
            android:fontFamily="sans-serif"
            android:textIsSelectable="true"
            android:singleLine="false"
            android:breakStrategy="balanced"
            android:hyphenationFrequency="none"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone"
            tools:text="Couldn't reach the relay. Check your internet."
            tools:visibility="visible" />

        <!-- One-line helper copy below the status — explains what the
             app is doing in plain English while the user is just sitting
             on this screen. Replaces the LAN-IP value as the user's
             reassurance that the bridge is alive. -->
        <TextView
            android:id="@+id/relayHelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/relay_help_text"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.35"
            android:layout_marginTop="@dimen/space_16" />

        <!-- ============ 4. Action stack ============ -->
        <!-- reconnectButton kept hidden for back-compat with the Kotlin
             field declaration (initializeMainPane findViewById still
             resolves it). Permanently GONE — see dispatch #9. -->
        <Button
            android:id="@+id/reconnectButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/action_reconnect"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_primary"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_24" />

        <!-- Disconnect (active pair) — dispatch #34 / v20.
             Sits ABOVE Sign Out in the action stack. Sign Out clears the
             saved login on the phone; Disconnect terminates the current
             ACTIVE pair without signing out. Phone stays signed in,
             returns to lobby state, browser flips back to "Phone in
             lobby — ready to pair". Visible only when a pair is active
             (PhoneService.getIsPairActive() == true); MainActivity hides
             this in lobby/idle/connecting/failed states via updateStatus
             + handleRelayPhaseChanged so the only time the user sees
             this affordance is when there's actually something to
             disconnect FROM.
             Styled subtly (smaller height + tertiary text color) so it
             reads as a finer "drop this session" action than Sign Out
             which is the bigger "leave entirely" affordance below it. -->
        <Button
            android:id="@+id/disconnectPairButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_disconnect_pair"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_24"
            tools:visibility="visible" />

        <!-- Sign Out — repurposed from the old disconnectButton id.
             MainActivity rebinds the click handler to clear TokenStore
             + relaunch SignInActivity. Same id keeps the existing
             findViewById call site unchanged. -->
        <Button
            android:id="@+id/disconnectButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_sign_out"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <Button
            android:id="@+id/enable_notifications_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_enable_notifications"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_warning"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_12" />

        <!-- ============ 5. Hard Reset (low-priority escape hatch) ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:background="@color/surface_border"
            android:layout_marginTop="@dimen/space_32" />

        <Button
            android:id="@+id/hardResetButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_hard_reset"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_16" />

        <TextView
            android:id="@+id/hardResetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_hard_reset_subtitle"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:layout_marginTop="@dimen/space_6" />

    </LinearLayout>
</ScrollView>
