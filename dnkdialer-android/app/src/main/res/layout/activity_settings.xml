<?xml version="1.0" encoding="utf-8"?>
<!--
  v56 — Settings screen.

  PLAIN, UNSTYLED-BUT-FUNCTIONAL. Every control here works and is wired
  in SettingsActivity.kt; the visual treatment (row-groups under caps
  labels, hairlines, 56dp rows, icon tiles, the light/dark token set from
  DIRECTION-android-v56.md) is Pixel's job in v56 step 2. Pixel: restyle
  this file freely, but keep the ids — SettingsActivity binds all of them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_24"
        android:paddingEnd="@dimen/space_24"
        android:paddingTop="@dimen/space_24"
        android:paddingBottom="@dimen/space_32">

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/space_24" />

        <!-- ================= CONNECTION ================= -->
        <TextView
            android:id="@+id/settingsLabelConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_connection"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09" />

        <Button
            android:id="@+id/settingsLobbyToggleButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_disconnect_lobby"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <TextView
            android:id="@+id/settingsLobbySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_lobby_subtitle"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_6" />

        <!-- ================= SYNCED DATA ================= -->
        <TextView
            android:id="@+id/settingsLabelSynced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_synced_data"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:layout_marginTop="@dimen/space_32" />

        <Button
            android:id="@+id/settingsViewMessagesButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/synced_entry_messages"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <Button
            android:id="@+id/settingsViewCallsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/synced_entry_calls"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <!-- ================= PERMISSIONS ================= -->
        <TextView
            android:id="@+id/settingsLabelPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_permissions"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:layout_marginTop="@dimen/space_32" />

        <Button
            android:id="@+id/settingsPermissionsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/settings_open_permissions"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <!-- Shown only when notifications are blocked at the system level;
             SettingsActivity flips visibility on every resume. -->
        <Button
            android:id="@+id/settingsEnableNotificationsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_enable_notifications"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_warning"
            android:stateListAnimator="@null"
            android:visibility="gone"
            android:layout_marginTop="@dimen/space_12" />

        <Button
            android:id="@+id/settingsNotificationSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/settings_open_notifications"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <!-- ================= ACCOUNT ================= -->
        <TextView
            android:id="@+id/settingsLabelAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_account"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:layout_marginTop="@dimen/space_32" />

        <Button
            android:id="@+id/settingsSignOutButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_sign_out"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <!-- ================= TROUBLESHOOTING ================= -->
        <TextView
            android:id="@+id/settingsLabelTroubleshooting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_section_troubleshooting"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_label"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:layout_marginTop="@dimen/space_32" />

        <Button
            android:id="@+id/settingsHardResetButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_small"
            android:text="@string/action_hard_reset"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:layout_marginTop="@dimen/space_12" />

        <TextView
            android:id="@+id/settingsHardResetSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_hard_reset_subtitle"
            android:textSize="@dimen/text_caption"
            android:textColor="@color/text_tertiary"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginTop="@dimen/space_6" />

    </LinearLayout>
</ScrollView>
