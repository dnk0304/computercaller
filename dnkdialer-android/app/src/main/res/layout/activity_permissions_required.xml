<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions-required pane (Round 8).

  Replaces the per-card Grant pattern from Round 6/7 with a single
  primary CTA: "Grant All Permissions". Tapping it kicks off the OS-
  native runtime-permission popup (batched — Android shows the dialogs
  back-to-back automatically when multiple permissions are passed to
  ActivityCompat.requestPermissions). After the runtime batch resolves,
  any remaining special-access grants (Notification Listener, Battery
  optimization) are handled by a single confirmation dialog + sequential
  Settings deep-links, with onResume detection driving the transitions.

  Layout vertical stack:
    1. Wordmark + gradient underline (same treatment as main pane, so
       the user knows they're still in ComputerCaller, not Settings).
    2. Title row (amber attention dot + "Permissions needed").
    3. Subtitle explaining the one-tap flow.
    4. Primary CTA — "Grant All Permissions".
    5. Expandable "What does this need access to?" section with a
       categorized breakdown of each permission for the curious. Hidden
       by default so the pane reads as clean and confident.
    6. Sticky Refresh button — re-runs the check without leaving the
       Activity (safety net for OEM grant flows that don't return to us).

  Success animation overlay (FrameLayout sibling of the scroll content):
    full-screen green check on dot_live, fades in/out over 800ms when
    the last permission resolves.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permissionsRequiredRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <!-- ============ Scrollable body ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_28"
            android:paddingEnd="@dimen/space_28"
            android:paddingTop="@dimen/space_40"
            android:paddingBottom="@dimen/space_40">

            <!-- Wordmark — same treatment as the main pane. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_wordmark"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.95"
                android:includeFontPadding="false" />

            <View
                android:layout_width="@dimen/wordmark_underline_width"
                android:layout_height="@dimen/wordmark_underline_height"
                android:background="@drawable/bg_accent_underline"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_32" />

            <!-- Title — pairs the dot affordance (amber 'attention') with
                 the headline. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/dot_waiting"
                    android:layout_marginEnd="@dimen/space_12"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perms_title"
                    android:textSize="@dimen/text_status"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <!-- Subtitle — explains the one-tap flow. -->
            <TextView
                android:id="@+id/permsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perms_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="@dimen/space_12" />

            <!-- Primary CTA. Full-width, gradient, gets the user moving
                 in one tap. -->
            <Button
                android:id="@+id/permsGrantAllButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/perms_grant_all"
                android:textSize="@dimen/text_body"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginTop="@dimen/space_32" />

            <!-- Expandable details toggle. Reads as a quiet link — small,
                 secondary color, no chrome. Tapping it expands the list
                 below; tapping again collapses. -->
            <TextView
                android:id="@+id/permsDetailsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perms_details_show"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_8"
                android:layout_marginTop="@dimen/space_20"
                android:background="?attr/selectableItemBackground" />

            <!-- Expandable detail panel. Hidden by default. Contains two
                 sections (Standard / Special access) with one row per
                 permission. Each row is inflated from item_missing_permission
                 (repurposed — no Grant chip, just title + why). -->
            <LinearLayout
                android:id="@+id/permsDetailsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="@dimen/space_12">

                <TextView
                    android:id="@+id/permsRuntimeSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perms_details_section_runtime"
                    android:textSize="@dimen/text_eyebrow"
                    android:textColor="@color/text_label"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="@dimen/space_12" />

                <LinearLayout
                    android:id="@+id/permsRuntimeList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="UselessLeaf" />

                <TextView
                    android:id="@+id/permsSpecialSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/perms_details_section_special"
                    android:textSize="@dimen/text_eyebrow"
                    android:textColor="@color/text_label"
                    android:textAllCaps="true"
                    android:letterSpacing="0.18"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="@dimen/space_20"
                    android:layout_marginBottom="@dimen/space_12" />

                <LinearLayout
                    android:id="@+id/permsSpecialList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="UselessLeaf" />
            </LinearLayout>

            <!-- Refresh — the safety net. -->
            <Button
                android:id="@+id/permsRefreshButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_small"
                android:text="@string/perms_refresh"
                android:textSize="@dimen/text_body"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_button_ghost"
                android:stateListAnimator="@null"
                android:layout_marginTop="@dimen/space_24" />

        </LinearLayout>
    </ScrollView>

    <!-- ============ Success overlay ============ -->
    <FrameLayout
        android:id="@+id/permsSuccessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_base"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/status_dot"
                android:backgroundTint="@color/dot_live"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perms_all_set"
                android:textSize="@dimen/text_status"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:layout_marginTop="@dimen/space_20" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
