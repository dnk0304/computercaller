<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions-required pane. Shown by MainActivity when PermissionChecker
  reports any missing runtime permission or special-access grant. Blocks
  the main control surface until everything is granted.

  Design language matches the rest of the app:
    - Wordmark + warm-accent underline at the top so the user knows
      they're still in DNK Dialer (not Settings).
    - Title + subtitle pair under the wordmark.
    - Scrollable list of cards (recessed bg_url_block surface with the
      warm left bar — same visual treatment as the URL block on main,
      reads as "this is the data that matters").
    - Each card: human-readable title, one-line why, Grant chip on the
      right (hairline-bordered warm accent — bg_button_warning).
    - Sticky Refresh button at the bottom for the user to re-check after
      coming back from a grant flow that DIDN'T trigger onResume (rare).

  Success animation overlay (FrameLayout sibling of the scroll content):
    full-screen green check on dot_live, fades in/out over 800ms when
    the last permission resolves. Sits on top of the scroll content so
    the user gets a clear "you're done" beat before the main pane appears.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permissionsRequiredRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base">

    <!-- ============ Scrollable body ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_28"
            android:paddingEnd="@dimen/space_28"
            android:paddingTop="@dimen/space_40"
            android:paddingBottom="@dimen/space_40">

            <!-- Wordmark — same treatment as the main pane so the user
                 knows they didn't get punted into Settings. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/text_wordmark"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.95"
                android:includeFontPadding="false" />

            <View
                android:layout_width="@dimen/wordmark_underline_width"
                android:layout_height="@dimen/wordmark_underline_height"
                android:background="@drawable/bg_accent_underline"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginBottom="@dimen/space_32" />

            <!-- Title — pairs the dot affordance (amber 'attention') with
                 the headline. Reusing the existing status_dot drawable +
                 dot_waiting tint so this screen feels like a deliberate
                 state of the app, not a foreign error screen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/dot_size"
                    android:layout_height="@dimen/dot_size"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/dot_waiting"
                    android:layout_marginEnd="@dimen/space_12"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perms_title"
                    android:textSize="@dimen/text_status"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <!-- Subtitle — names the Samsung-revoke pattern explicitly so
                 the user doesn't think they did something wrong. -->
            <TextView
                android:id="@+id/permsSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perms_subtitle"
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.35"
                android:layout_marginTop="@dimen/space_12" />

            <!-- The list. Populated at runtime from PermissionChecker.checkAll().
                 Using a vertical LinearLayout rather than RecyclerView because
                 the list is small (max ~11 entries) and we want the whole
                 thing inside the ScrollView with the title + Refresh button
                 — RecyclerView inside ScrollView is more friction than it's
                 worth at this scale. -->
            <LinearLayout
                android:id="@+id/missingPermissionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_32"
                tools:ignore="UselessLeaf" />

            <!-- Refresh — the safety net. onResume re-checks automatically
                 when the user returns from Settings, but some OEM flows
                 don't return to the calling Activity (Samsung's battery
                 settings sometimes drop the user on the Home screen). This
                 button lets them re-check without killing the app. -->
            <Button
                android:id="@+id/permsRefreshButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/perms_refresh"
                android:textSize="@dimen/text_body"
                android:textAllCaps="false"
                android:textColor="@color/surface_base"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginTop="@dimen/space_40" />

        </LinearLayout>
    </ScrollView>

    <!-- ============ Success overlay ============
         Hidden by default. MainActivity flips it to VISIBLE + animates
         alpha 0→1→0 over 800ms when the last permission resolves, then
         hides the whole permissionsRequiredRoot and reveals the main
         pane. Background is the same surface_base so the alpha fade
         doesn't reveal the form behind it; the green checkmark sits
         centered to give the "all set" beat its own moment. -->
    <FrameLayout
        android:id="@+id/permsSuccessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_base"
        android:alpha="0"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Reusing status_dot as a 64dp green disc. No vector asset
                 needed — the dot drawable is just a circle, and scaling
                 it up gives us the same shape language the rest of the
                 app uses for state. -->
            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/status_dot"
                android:backgroundTint="@color/dot_live"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perms_all_set"
                android:textSize="@dimen/text_status"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:layout_marginTop="@dimen/space_20" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
