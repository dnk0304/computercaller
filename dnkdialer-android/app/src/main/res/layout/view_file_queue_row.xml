<?xml version="1.0" encoding="utf-8"?>
<!--
  FILE-QUEUE — one row under the transfer card (FileTransferCard.renderQueue).
  Name + one state line; up to two text actions (Remove / Cancel / Retry /
  Pick again / Open / Clear) per the ADDENDUM 2 state table. 48dp targets.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_6"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:id="@+id/ftRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="@dimen/cc_text_row_title"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            tools:text="holiday-video-2026.mp4" />

        <TextView
            android:id="@+id/ftRowState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/cc_text_foot"
            android:textColor="@color/text_tertiary"
            tools:text="Queued · 12 MB" />
    </LinearLayout>

    <TextView
        android:id="@+id/ftRowSecondary"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingStart="@dimen/space_10"
        android:paddingEnd="@dimen/space_10"
        android:textSize="@dimen/cc_text_sub"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        tools:text="@string/ft_queue_remove"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/ftRowPrimary"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:paddingStart="@dimen/space_10"
        android:paddingEnd="@dimen/space_10"
        android:textSize="@dimen/cc_text_sub"
        android:textColor="@color/accent_blue"
        android:fontFamily="sans-serif-medium"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        tools:text="@string/ft_queue_retry"
        tools:visibility="visible" />
</LinearLayout>
