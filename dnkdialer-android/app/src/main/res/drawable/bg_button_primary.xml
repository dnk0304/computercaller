<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary action button — Round 7 sleek-tech.
  Diagonal gradient electric-blue → cyan-shifted blue (top-left → bottom-right).
  Avoids the "flat brand color on giant button" tutorial-app look; gradient
  signals depth + dimensionality which is doing most of the futuristic work
  on this surface.

  Pressed: solid darker blue (no gradient) — gives the tap a clear "settled"
  beat. Disabled state inherits accent_blue_dim via tint.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_blue_pressed" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_blue_dim" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- Diagonal: angle=315 → top-left to bottom-right.
                 startColor is the slightly-lighter blue, end is the
                 saturated brand blue, so the highlight reads as light
                 falling from upper-left (matching the OS shadow model). -->
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/accent_cyan"
                android:centerColor="@color/accent_blue"
                android:endColor="@color/accent_blue_pressed" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
</content>
</invoke>