<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy button — Round 7.
  Hairline white-at-10% border on transparent. Sits next to the URL
  block. Reads as "tool / utility", not "primary action". Pressed
  state fills with a slightly raised surface for the tap beat.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/surface_border_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
