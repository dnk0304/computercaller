<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy button — slim hairline-bordered chip. Sits next to the URL
  block. Reads as "tool", not "primary action".
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_raised" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/surface_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_chip" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
