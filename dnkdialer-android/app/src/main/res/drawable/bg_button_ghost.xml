<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghost button — borderless secondary label. Used for Disconnect.
  Round 7: pressed state fills with surface_inset (was surface_inset
  in R6 too — kept since the new palette has the same name pointing
  at the right hex). Reads as "stop / cancel" without competing with
  the primary gradient.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_inset" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
</content>
</invoke>