<?xml version="1.0" encoding="utf-8"?>
<!-- Equal-weight companion to the brand pill: Decline beside Accept,
     Disconnect inside the connected card. Outline only, because the
     affirmative is the only filled control on any screen. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F808080">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/surface_border_strong" />
            <corners android:radius="@dimen/cc_radius_pill" />
        </shape>
    </item>
</ripple>
