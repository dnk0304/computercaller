<?xml version="1.0" encoding="utf-8"?>
<!--
  Wordmark accent underline — Round 7.
  Electric-blue → cyan horizontal gradient. Same single visual detail
  as before, just with the new palette. Slightly raised corner radius
  (1 → 2dp) so the stroke reads as a deliberate object, not a hairline.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/accent_blue"
        android:endColor="@color/accent_cyan" />
    <corners android:radius="2dp" />
</shape>
</content>
</invoke>