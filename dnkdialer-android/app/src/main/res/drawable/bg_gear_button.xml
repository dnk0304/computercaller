<?xml version="1.0" encoding="utf-8"?>
<!-- App-bar icon button. The visible circle is 36dp; the view around it is
     48dp so the touch target clears the Android minimum. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F808080">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/surface_inset" />
        </shape>
    </item>
</ripple>
