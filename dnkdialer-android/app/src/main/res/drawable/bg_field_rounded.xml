<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in text field. Rounded (14dp) recessed surface with a hairline, and
     a 2dp brand-end border when focused so keyboard focus is unmistakable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/field_surface" />
            <stroke android:width="2dp" android:color="@color/field_border_focused" />
            <corners android:radius="@dimen/cc_radius_band" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/field_surface" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
            <corners android:radius="@dimen/cc_radius_band" />
        </shape>
    </item>
</selector>
