<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions-needed chip. Hairline border in the warm accent so it
  picks up the screen's only color signal — same single-accent
  discipline as everything else.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_inset" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/accent_warm" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/accent_warm" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
