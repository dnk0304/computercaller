<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions-needed chip — Round 7.
  Hairline electric-blue border on transparent. Picks up the screen's
  primary accent without competing with the gradient primary CTA.
  Same single-accent discipline as the rest of the design.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_inset" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/accent_blue" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/accent_blue" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
</content>
</invoke>