<?xml version="1.0" encoding="utf-8"?>
<!--
  The ComputerCaller mark, ported from public/brand/computercaller-lockup.svg
  (the same geometry Pixel-J shipped on the web app and the extension) so the
  phone, the browser and the site all show one mark.

  The SVG draws the mark as white line-art on a gradient plate. On a phone the
  plate would fight the flat page surface (DIRECTION trait 2: separation by
  surface, not shadow), so the plate is dropped and the SAME strokes carry the
  brand ramp instead - which is also what the mockups used. The ramp is the
  135deg #35c977 -> #22a89a -> #1e8fb2 from DIRECTION-android-v56.md, fixed in
  both themes, and this mark is one of the three things allowed to wear it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="34dp"
    android:height="34dp"
    android:viewportWidth="128"
    android:viewportHeight="128">

    <!-- Monitor body, stand, and phone body. Stroke 6 in the source. -->
    <path
        android:pathData="M30,34 h40 a6,6 0 0 1 6,6 v28 a6,6 0 0 1 -6,6 h-40 a6,6 0 0 1 -6,-6 v-28 a6,6 0 0 1 6,-6 z M42,82 h16 M50,74 v8 M90,40 h14 a6,6 0 0 1 6,6 v36 a6,6 0 0 1 -6,6 h-14 a6,6 0 0 1 -6,-6 v-36 a6,6 0 0 1 6,-6 z"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="14" android:startY="14"
                android:endX="114" android:endY="114">
                <item android:offset="0" android:color="#35C977" />
                <item android:offset="0.55" android:color="#22A89A" />
                <item android:offset="1" android:color="#1E8FB2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The call arc from the monitor to the phone. Stroke 5 in the source. -->
    <path
        android:pathData="M44,60 q20,-18 44,-6"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="44" android:startY="42"
                android:endX="88" android:endY="60">
                <item android:offset="0" android:color="#35C977" />
                <item android:offset="1" android:color="#1E8FB2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Phone earpiece slot. Stroke 4 in the source. -->
    <path
        android:pathData="M92,46 h10"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeColor="#1E8FB2" />

    <!-- Phone home dot. -->
    <path
        android:pathData="M94.6,82.5 a2.4,2.4 0 1 0 4.8,0 a2.4,2.4 0 1 0 -4.8,0 z"
        android:fillColor="#1E8FB2" />

    <!-- The handset bubble sitting over the arc. In the source SVG the disc is
         white (it sits on the gradient plate); with the plate gone a white disc
         would disappear on a light page, so the disc takes the ramp and the
         handset is knocked out in white. Same silhouette, legible on both
         surfaces. -->
    <path
        android:pathData="M50,61 a15,15 0 1 0 30,0 a15,15 0 1 0 -30,0 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="50" android:startY="46"
                android:endX="80" android:endY="76">
                <item android:offset="0" android:color="#35C977" />
                <item android:offset="1" android:color="#1E8FB2" />
            </gradient>
        </aapt:attr>
    </path>
    <group android:translateX="56" android:translateY="52">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M4.4,5.1c-0.5,0.4 -0.8,1 -0.7,1.7c0.3,2.2 1.4,4.3 3,5.9c1.6,1.6 3.7,2.7 5.9,3c0.7,0.1 1.3,-0.2 1.7,-0.7l0.9,-1.2c0.3,-0.5 0.2,-1.1 -0.2,-1.4l-2,-1.4c-0.4,-0.3 -0.9,-0.2 -1.2,0.1l-0.7,0.8c-1.2,-0.6 -2.2,-1.6 -2.8,-2.8l0.8,-0.7c0.3,-0.3 0.4,-0.8 0.1,-1.2l-1.4,-2c-0.3,-0.4 -0.9,-0.5 -1.4,-0.2z" />
    </group>
</vector>
