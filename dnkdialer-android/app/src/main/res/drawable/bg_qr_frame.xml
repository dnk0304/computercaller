<?xml version="1.0" encoding="utf-8"?>
<!--
  QR backdrop — warm off-white (not pure white) so it sits softer
  against the warm near-black canvas. 8dp internal padding via the
  ImageView's android:padding.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_qr" />
    <corners android:radius="8dp" />
</shape>
