<?xml version="1.0" encoding="utf-8"?>
<!--
  Status dot — 12dp circle. Tinted at runtime from MainActivity via
  setBackgroundTintList(...). The default fill is white so the tint
  reads accurately on top.

  Round 7: the dot is paired with a glow ring (status_dot_ring) when
  LIVE, and is the animation target for the CONNECTING pulse. Size
  bumped to 12dp via dimens (was 14dp R6 — the ring takes the visual
  weight now, so the dot itself can be tighter).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
    <size
        android:width="@dimen/dot_size"
        android:height="@dimen/dot_size" />
</shape>
