<?xml version="1.0" encoding="utf-8"?>
<!--
  Status dot — 8dp circle. Tinted at runtime from MainActivity via
  setBackgroundTintList(...). The default fill is white so the tint
  reads accurately on top.

  The dot is intentionally tiny — status hierarchy in this design is
  carried by the step-number (01/02/03) typography next to it, not by
  the dot. The dot is just a punctuation mark.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/white" />
    <size
        android:width="@dimen/dot_size"
        android:height="@dimen/dot_size" />
</shape>
