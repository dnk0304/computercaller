<?xml version="1.0" encoding="utf-8"?>
<!--
  "Sign in with Google" light button surface, per Google branding spec:
  white fill, 1dp #747775 stroke, rounded corners. Ripple on press.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F1F1F1A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/google_btn_surface" />
            <stroke android:width="1dp" android:color="@color/google_btn_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
