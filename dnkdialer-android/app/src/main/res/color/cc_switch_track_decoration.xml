<?xml version="1.0" encoding="utf-8"?>
<!-- The 2dp ring MaterialSwitch draws around the track. Visible only in
     the OFF state, where it is what makes an unfilled track read as a control
     rather than a gap; transparent when ON so the brand fill is clean. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@android:color/transparent" />
    <item android:color="@color/surface_border_strong" />
</selector>
