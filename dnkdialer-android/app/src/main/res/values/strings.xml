    <!-- Connection-state transitions for the LAN flow.
         CONNECTING / FAILED are surfaced in the status row; the failure
         copy is mapped from close code + exception class so the user
         gets actionable advice instead of "WebSocket error". -->
    <string name="status_connecting_relay">Connecting…</string>
    <string name="status_failed_prefix">Couldn\'t connect.</string>
    <string name="status_failed_refused">Couldn\'t reach the relay at %1$s. Is the dev server running?</string>
    <string name="status_failed_timeout">Connection timed out. Check that your phone is on the same WiFi as your computer.</string>
    <!-- Client-side 10s connect-timeout. Fires when the WS handshake
         never completes (silent firewall drop, wrong IP, VPN interference) —
         the WebSocket lib would otherwise hang the user in CONNECTING for
         ~75s+ before the OS finally surfaces the TCP failure. -->
    <string name="error_connect_timeout">Connection timed out — check WiFi / firewall.</string>
    <string name="status_failed_unknown_host">Couldn\'t resolve %1$s. Check the relay host address.</string>
    <string name="status_failed_invalid_token">Invalid pairing token. Re-scan the QR from your account settings.</string>
    <string name="status_failed_generic">Connect failed: %1$s</string>
    <string name="status_target_prefix">Target: %1$s</string>

