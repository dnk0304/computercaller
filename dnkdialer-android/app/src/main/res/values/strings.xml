<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ComputerCaller</string>
    <string name="wordmark_dnk">Computer</string>
    <string name="wordmark_dialer">Caller</string>
    <string name="tagline">A companion for the web app — your phone, on your screen.</string>

    <!-- Step labels (status section) -->
    <string name="step_01">01</string>
    <string name="step_02">02</string>
    <string name="step_03">03</string>

    <!-- Section eyebrows — kept minimal. Round 3 cut "Current state"
         entirely (the giant dot + word IS the state). -->
    <string name="label_address">Listening at</string>
    <string name="label_scan">Scan to pair</string>

    <!-- Status copy — the dot is the PRIMARY signal. Labels are 1–2
         words, scannable in 200ms. Verbose copy lives in toasts and
         logs, not the headline. -->
    <string name="status_starting">Starting</string>
    <string name="status_loading_ip">Resolving address</string>
    <string name="status_disconnected">Offline</string>
    <string name="status_restarting">Restarting</string>
    <string name="status_ready">Ready</string>
    <string name="status_connecting">Connecting</string>
    <string name="status_waiting_for_web">Waiting for browser</string>
    <string name="status_live">Connected</string>
    <string name="status_service_not_running">Offline</string>
    <string name="status_perms_requesting">Requesting permissions</string>
    <string name="status_perms_needed">Permissions needed</string>
    <string name="status_perms_denied_permanent">Permissions blocked</string>
    <string name="status_perms_denied_permanent_hint">Grant access in App Settings to continue.</string>
    <string name="status_battery_request">Battery permission</string>
    <string name="status_battery_request_hint">Required so the service stays alive in the background.</string>
    <string name="status_perms_granted">Permissions granted</string>

    <!-- Buttons -->
    <string name="action_copy">Copy</string>
    <string name="action_copy_long">Copy address to clipboard</string>
    <!-- Round 7 → dispatch #6 → dispatch #9 lineage.
         R7 = "Refresh" (port-rebind, useless to user).
         Dispatch #6 = "Start" — partner button that appeared only when
                       the user had explicitly Disconnected; introduced a
                       userStopped latch + a dual-button stopped state.
         Dispatch #9 (2026-05-22) = THE BUTTON IS GONE.
                       Dennis wanted a single button labelled
                       "Disconnect and refresh" — one tap, polite-close
                       active clients, stopService, 800ms postDelayed,
                       startPhoneService → back to the ready state. No
                       stopped-state, no Start partner, no userStopped
                       latch. The reconnectButton XML widget is still
                       present (id retained to avoid layout churn) but
                       hidden permanently — see MainActivity for the
                       visibility=GONE force.
         Resource key `action_reconnect` kept as a tombstone string
         pointing readers to this comment. The button it referenced is
         no longer surfaced. -->
    <string name="action_reconnect">Start</string>
    <!-- Shown on the same button while the service is spinning up. Now
         orphan after dispatch #9 (the partner button is gone) but
         retained as a one-round tombstone. -->
    <string name="action_connecting">Starting…</string>
    <!-- Dispatch #9: the single remaining lifecycle button is now
         labelled "Disconnect and refresh". Underlying handler:
         polite close → stopService → 800ms postDelayed → startPhoneService.
         User-visible effect = phone briefly drops the LAN socket then
         comes back live with a fresh QR + IP. -->
    <string name="action_disconnect">Disconnect and refresh</string>
    <string name="action_enable_notifications">Enable notifications</string>
    <string name="action_open_app_settings">Open app settings</string>

    <!-- Toasts -->
    <string name="toast_copied">Address copied</string>
    <!-- Tombstone strings — were used by the dispatch #6 "Start" button
         path that no longer exists. Kept one round in case rollback. -->
    <string name="toast_refreshed">Refreshed — ready at %1$s</string>

    <!-- Connection-state transitions for the LAN flow.
         CONNECTING / FAILED are surfaced in the status row; the failure
         copy is mapped from close code + exception class so the user
         gets actionable advice instead of "WebSocket error". -->
    <string name="status_connecting_relay">Connecting…</string>
    <string name="status_failed_prefix">Couldn\'t connect.</string>
    <string name="status_failed_refused">Couldn\'t reach the relay at %1$s. Is the dev server running?</string>
    <string name="status_failed_timeout">Connection timed out. Check that your phone is on the same WiFi as your computer.</string>
    <!-- Client-side 10s connect-timeout. Fires when the WS handshake
         never completes (silent firewall drop, wrong IP, VPN interference) —
         the WebSocket lib would otherwise hang the user in CONNECTING for
         ~75s+ before the OS finally surfaces the TCP failure. -->
    <string name="error_connect_timeout">Connection timed out — check WiFi / firewall.</string>
    <string name="status_failed_unknown_host">Couldn\'t resolve %1$s. Check the relay host address.</string>
    <string name="status_failed_invalid_token">Invalid pairing token. Re-scan the QR from your account settings.</string>
    <string name="status_failed_generic">Connect failed: %1$s</string>
    <string name="status_target_prefix">Target: %1$s</string>

    <!-- Content descriptions -->
    <string name="cd_qr">QR code — scan it with the web app to pair.</string>
    <string name="cd_status_dot">Connection state indicator</string>

    <!-- Format strings — collapsed to a single short label.
         "Connected" reads at a glance; the client count goes in logs. -->
    <string name="status_connected_to_host">Connected</string>
    <string name="status_clients_connected_one">Connected</string>
    <string name="status_clients_connected_many">Connected · %1$d</string>
    <string name="status_error_format">%1$s</string>
    <string name="status_perms_denied_count">%1$d permissions required</string>
    <string name="status_cannot_start_without_perms">Cannot start without permissions</string>
    <string name="status_failed_to_start">Failed to start</string>

    <!-- =================================================== -->
    <!-- Permissions-required pane (Samsung One UI auto-revoke -->
    <!-- defense). Shown by MainActivity when                  -->
    <!-- PermissionChecker.checkAll() returns a non-empty list. -->
    <!--                                                       -->
    <!-- Round 8 — replaced per-card Grant chips with a single -->
    <!-- "Grant All" primary CTA that fires the OS-native      -->
    <!-- runtime-permissions popup (batched) and then walks    -->
    <!-- the user through the two special-access settings      -->
    <!-- screens that can't be granted via popup.              -->
    <!-- =================================================== -->
    <string name="perms_title">Permissions needed</string>
    <string name="perms_subtitle">ComputerCaller needs a handful of permissions to connect to your phone. Tap below to grant them all in one go.</string>
    <string name="perms_grant">Grant</string>
    <string name="perms_grant_all">Grant All Permissions</string>
    <string name="perms_refresh">I\'ve granted everything — re-check</string>
    <string name="perms_all_set">All set</string>
    <string name="perms_details_show">What does this need access to?</string>
    <string name="perms_details_hide">Hide details</string>
    <string name="perms_details_section_runtime">Standard permissions (one popup)</string>
    <string name="perms_details_section_special">Special access (Settings screens)</string>

    <!-- Special-access intro dialog. Shown after the OS runtime popup is
         dismissed if Notification Listener and/or Battery still need to
         be granted (those CAN'T be requested via runtime popup — Android
         requires the user to enable them in Settings). -->
    <string name="perms_special_dialog_title">Two more to go</string>
    <string name="perms_special_dialog_message_both">Two permissions need to be granted in Settings: Notification Access and Battery (Don\'t optimize). Tap each one when prompted, then come back here.</string>
    <string name="perms_special_dialog_message_listener">Notification Access needs to be granted in Settings. Find ComputerCaller in the list and turn it on, then come back here.</string>
    <string name="perms_special_dialog_message_battery">Battery (Don\'t optimize) needs to be granted in Settings. Tap Allow when prompted, then come back here.</string>
    <string name="perms_special_dialog_action">Take me there</string>
    <string name="perms_special_dialog_cancel">Not now</string>

    <!-- Per-permission rows. Display name on top of each card,
         single-line "why we need this" below. -->
    <string name="perm_name_notifications">Notifications</string>
    <string name="perm_why_notifications">Show incoming-call alerts on your phone.</string>

    <string name="perm_name_notif_listener">Notification access</string>
    <string name="perm_why_notif_listener">Mirror messaging app notifications to the web app.</string>

    <string name="perm_name_phone">Phone</string>
    <string name="perm_why_phone">Place calls dialed from the web app.</string>

    <string name="perm_name_phone_state">Phone state</string>
    <string name="perm_why_phone_state">Detect when a call connects or ends.</string>

    <string name="perm_name_answer">Answer calls</string>
    <string name="perm_why_answer">Accept incoming calls from the web app UI.</string>

    <string name="perm_name_contacts">Contacts</string>
    <string name="perm_why_contacts">Match incoming callers to your saved names.</string>

    <string name="perm_name_call_log">Call logs</string>
    <string name="perm_why_call_log">Sync recent calls to the web app.</string>

    <string name="perm_name_read_sms">Read SMS</string>
    <string name="perm_why_read_sms">Show your SMS threads in the web app.</string>

    <string name="perm_name_send_sms">Send SMS</string>
    <string name="perm_why_send_sms">Send SMS from your computer.</string>

    <string name="perm_name_receive_sms">Receive SMS</string>
    <string name="perm_why_receive_sms">Forward incoming SMS to the web app.</string>

    <string name="perm_name_camera">Camera</string>
    <string name="perm_why_camera">Scan QR codes for pairing.</string>

    <string name="perm_name_battery">Battery — don\'t optimize</string>
    <string name="perm_why_battery">Samsung-specific. Keeps the connection alive when the screen is off.</string>

    <string name="perm_name_auto_revoke">Keep permissions when unused</string>
    <string name="perm_why_auto_revoke">Stops Android from silently revoking call/SMS access if the app sits in the background for days.</string>

    <!-- 2-mode BT audio routing (2026-05-25). Soft permission — the app
         works fine without it; only the "Speak through PC" routing mode
         is disabled when BLUETOOTH_CONNECT is not granted, since we can't
         read HFP profile state or device names without it. -->
    <string name="perm_name_bluetooth_connect">Nearby Bluetooth devices</string>
    <string name="perm_why_bluetooth_connect">Route call audio to your PC over Bluetooth (HFP). Without this, only Phone Earpiece / Phone Speaker work.</string>

    <!-- =================================================== -->
    <!-- Hard Reset — manual escape hatch for the "Samsung    -->
    <!-- silently revoked something" class of bugs. Wipes     -->
    <!-- app data via ActivityManager.clearApplicationUserData()-->
    <!-- and force-restarts the process, so the user lands    -->
    <!-- back on the Grant All pane with a clean slate.       -->
    <!-- =================================================== -->
    <string name="action_hard_reset">Hard Reset</string>
    <string name="action_hard_reset_subtitle">If connection fails repeatedly, tap to reset all permissions and start fresh.</string>
    <string name="hard_reset_dialog_title">Hard Reset?</string>
    <string name="hard_reset_dialog_message">This will reset all ComputerCaller data and you\'ll need to re-grant all permissions. Use this only if you can\'t connect normally. Continue?</string>
    <string name="hard_reset_dialog_cancel">Cancel</string>
    <string name="hard_reset_dialog_confirm">Reset</string>
    <string name="hard_reset_failed">Couldn\'t auto-reset. Open Settings → Apps → ComputerCaller → Storage → Clear data.</string>

    <!-- =================================================== -->
    <!-- Sign-in screen (dispatch #28, 2026-05-24).            -->
    <!-- First-launch gate. Stores phoneToken in              -->
    <!-- EncryptedSharedPreferences so PhoneService can       -->
    <!-- connect to the relay without re-prompting.           -->
    <!-- =================================================== -->
    <string name="signin_title">Sign in</string>
    <string name="signin_subtitle">Use the same email and password you use on computercaller.com.</string>
    <string name="signin_email_hint">Email</string>
    <string name="signin_password_hint">Password</string>
    <string name="signin_action">Sign In</string>
    <string name="signin_action_loading">Signing in…</string>
    <string name="signin_error_empty">Enter your email and password.</string>
    <string name="signin_error_network">Network error. Check your internet connection and try again.</string>
    <string name="signin_error_invalid">Invalid email or password.</string>
    <string name="signin_error_unverified">Please verify your email on computercaller.com first, then come back.</string>
    <string name="signin_error_generic">Sign-in failed. Try again.</string>
    <string name="signin_footer">Don\'t have an account? Sign up at computercaller.com first, then come back here.</string>

    <!-- Sign-out menu item replaces "Disconnect and refresh" once       -->
    <!-- the user is signed in. Clears stored phoneToken and returns     -->
    <!-- to SignInActivity. Phase 4 work — exposed via MainActivity.     -->
    <string name="action_sign_out">Sign out</string>

    <!-- Dispatch #34 (v20, 2026-05-25) — phone-initiated active-pair    -->
    <!-- teardown. Sits above Sign Out in the action stack. Tapping      -->
    <!-- ends the current pair (browser flips back to "Phone in lobby") -->
    <!-- but keeps the phone signed in and connected to the relay, so   -->
    <!-- the browser can immediately re-Connect without the user        -->
    <!-- re-signing-in on the phone. Visible only while a pair is       -->
    <!-- active (i.e. PhoneService.getIsPairActive() == true).           -->
    <string name="action_disconnect_pair">Disconnect</string>
    <string name="action_disconnect_pair_hint">End this session but stay signed in</string>

    <!-- Disconnect-from-lobby dispatch (v25, 2026-05-26).                -->
    <!-- New toggle button above the Disconnect (active pair) button.    -->
    <!-- Lets the user fully detach the phone from the relay lobby and   -->
    <!-- stay disconnected across app launches / OS service restarts.    -->
    <!-- The label flips based on TokenStore.isUserStayedDisconnected:   -->
    <!-- "Disconnect from Lobby" when connected, "Rejoin Lobby" when     -->
    <!-- disconnected. Sign Out implicitly clears the flag via           -->
    <!-- TokenStore.clear() so a fresh sign-in starts in the connected   -->
    <!-- auto-dial path again.                                            -->
    <string name="action_disconnect_lobby">Disconnect from Lobby</string>
    <string name="action_rejoin_lobby">Rejoin Lobby</string>
    <string name="status_user_disconnected">Disconnected — tap Rejoin to reconnect</string>

    <!-- SHORT variants for the persistent foreground-notification action    -->
    <!-- buttons (a notification action row has limited width, so the in-APP  -->
    <!-- "Disconnect from Lobby" / "Rejoin Lobby" labels above are too long). -->
    <!-- State-aware: "Disconnect" shows when in lobby, "Reconnect" when the  -->
    <!-- user has stayed disconnected. Both route through LobbyActionReceiver -->
    <!-- to the existing userDisconnectFromLobby/userRejoinLobby methods.     -->
    <string name="notif_action_disconnect">Disconnect</string>
    <string name="notif_action_reconnect">Reconnect</string>

    <!-- Relay-status surface — replaces the LAN-IP / QR plate after     -->
    <!-- Phase 4 lands. The Kotlin side feeds these into the status row. -->
    <string name="relay_status_waiting">Waiting for browser…</string>
    <string name="relay_status_paired">Connected · browser paired</string>
    <string name="relay_status_offline">Offline · check internet</string>

    <!-- Connect+Accept pivot (v18) — replaces the auto-pair help copy.
         Phone now stays in the relay lobby until the user actively
         accepts a pairing request from a browser. Help text directs them
         to start the flow on the web side. -->
    <string name="relay_help_text">Sign in on computercaller.com, then tap Connect. You\'ll get a prompt here to accept.</string>

    <!-- Dispatch #29 — Sign Out confirmation. Wipes the stored phoneToken
         and returns to SignInActivity. Phrased as a question with a
         clear "Sign out" action so an accidental tap doesn't lose the
         connection mid-call. -->
    <string name="signout_dialog_title">Sign out?</string>
    <string name="signout_dialog_message">You\'ll need to sign in again to reconnect to your computer. The phone bridge will stop until you do.</string>
    <string name="signout_dialog_cancel">Cancel</string>
    <string name="signout_dialog_confirm">Sign out</string>

    <!-- Dispatch #29 — Refresh-button copy that better matches Dennis's
         expectation of "I have granted all permissions". Previous copy
         was "I've granted everything — re-check" which only re-ran the
         audit and stayed stuck if the audit flagged a soft (informational)
         permission the user couldn't easily resolve. The new flow advances
         to the main pane as long as no BLOCKING (runtime call/SMS/etc.)
         permissions are still missing. -->
    <string name="perms_continue_anyway">Continue to app</string>
    <string name="perms_continue_anyway_hint">Some optional permissions are still missing but you can continue. Reliability may be reduced — you can grant them later from app settings.</string>

    <!-- =================================================== -->
    <!-- Connect+Accept gesture protocol (v18 / 2026-05-25). -->
    <!-- Phone lands in lobby on launch. Browser must request -->
    <!-- pairing; user must Accept on the phone before any   -->
    <!-- data flows. Replaces silent auto-pair.              -->
    <!-- =================================================== -->
    <string name="pair_request_title">Pairing request</string>
    <!-- Body templated with browser identification — typically
         "Chrome on macOS · 203.0.113.45" — first arg is ua label,
         single composed string sent by the relay. -->
    <string name="pair_request_body_template">%1$s wants to connect</string>
    <string name="pair_request_body_unknown">A browser wants to connect</string>
    <string name="pair_accept">Accept</string>
    <string name="pair_decline">Decline</string>
    <!-- Heads-up notification fallback when browser identification
         is absent. Matches the dialog copy intentionally. -->
    <string name="pair_request_notification_title">Pairing request</string>
    <!-- Foreground-notification text replacements during the
         PAIRING_ACTIVE / PAIRING_TERMINATED lifecycle. -->
    <string name="pair_active_notification">Connected — syncing data</string>
    <string name="pair_terminated_toast">Browser disconnected</string>
    <!-- Status row copy when relay is open but no active pair. -->
    <string name="pair_lobby_status">Lobby — waiting for browser to connect</string>

    <!-- =================================================== -->
    <!-- Permissions checklist (v18). Replaces the missing-only-->
    <!-- list with a full status view: every permission shown -->
    <!-- with ✓ green / ✗ red / ⚠ amber.                      -->
    <!-- =================================================== -->
    <string name="perm_status_granted">Granted</string>
    <string name="perm_status_missing_required">Required</string>
    <string name="perm_status_missing_soft">Optional</string>
    <string name="perm_continue_button">Continue</string>

    <!-- ============ Synced data viewer (Play verifiability fix, v40) ============ -->
    <!-- On-device view of the SMS + call log this app syncs. Lets a Play
         reviewer SEE the restricted-permission feature on ONE phone, no
         desktop pairing. -->
    <string name="synced_title">Synced data</string>
    <string name="synced_back">Back</string>
    <string name="synced_tab_messages">Synced messages</string>
    <string name="synced_tab_calls">Call history</string>
    <string name="synced_entry_messages">Synced messages</string>
    <string name="synced_entry_calls">Call history</string>
    <string name="synced_perm_messages">Grant SMS permission to view the messages this app syncs to your computer.</string>
    <string name="synced_perm_calls">Grant call-log permission to view the call history this app syncs to your computer.</string>
    <string name="synced_grant">Grant permission</string>
    <string name="synced_empty_messages">No messages found on this device yet.</string>
    <string name="synced_empty_calls">No calls found on this device yet.</string>
    <string name="synced_dir_received">Received</string>
    <string name="synced_dir_sent">Sent</string>
    <string name="synced_call_incoming">Incoming</string>
    <string name="synced_call_outgoing">Outgoing</string>
    <string name="synced_call_missed">Missed</string>
    <string name="synced_call_duration">Duration %1$s</string>
    <string name="synced_image_message">[Image message]</string>
    <string name="synced_unknown">Unknown</string>
</resources>
