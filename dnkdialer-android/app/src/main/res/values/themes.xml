<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      ComputerCaller companion theme (Round 7 — sleek-tech).

      Parent: MaterialComponents NoActionBar (Dark). The previous round
      used the light-base MaterialComponents variant; switching to the
      Dark base means OS-provided affordances (spinners, ripples,
      checkbox tints) inherit the right contrast on the near-black
      surface without per-widget overrides.

      Primary swapped warm-terracotta → electric blue (Apple system
      blue, #0A84FF). Status + nav bars match the surface so the app
      is one continuous canvas with no chrome seam.
    -->
    <style name="Theme.DNKDialerCompanion" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_pressed</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/surface_base</item>

        <item name="android:windowBackground">@drawable/bg_app_solid</item>
        <item name="android:statusBarColor">@color/surface_base</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Dark surface → light status-bar icons. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
