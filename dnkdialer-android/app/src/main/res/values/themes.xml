<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      ComputerCaller companion theme (Round 2).

      Parent: NoActionBar — the layout owns its own wordmark header.
      Background is FLAT now (was a gradient in round 1) — flat reads
      as confident, gradient as decorative. Status + nav bars match
      the surface so the app is one continuous canvas.
    -->
    <style name="Theme.DNKDialerCompanion" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_warm</item>
        <item name="colorPrimaryVariant">@color/accent_warm_pressed</item>
        <item name="colorOnPrimary">@color/surface_base</item>

        <item name="colorSecondary">@color/text_primary</item>
        <item name="colorSecondaryVariant">@color/text_secondary</item>
        <item name="colorOnSecondary">@color/surface_base</item>

        <item name="android:windowBackground">@drawable/bg_app_solid</item>
        <item name="android:statusBarColor">@color/surface_base</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Dark surface → light status-bar icons. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
