<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      ComputerCaller companion theme — v56.

      Parent is the DayNight variant of MaterialComponents NoActionBar.
      Pre-v56 it was the Dark variant and the app was dark-only; v56
      (decision 3 of DIRECTION-android-v56.md) shipped light AND dark.

      vc63 Amendment 1 (Dennis, 2026-09-23): the app is DARK again at
      runtime — CompanionApp pins AppCompatDelegate.MODE_NIGHT_YES, and
      there is no theme preference or selector for a user to override it
      with. The DayNight parent stays so this light configuration remains
      buildable and the screenshot fixtures can still force MODE_NIGHT_NO;
      it is no longer what the user sees.

      This file is the LIGHT configuration (fixture-only as of vc63);
      values-night/themes.xml carries the dark overrides the app actually
      runs in. Every colour here is a token from
      values/colors.xml, whose dark twin lives in values-night/colors.xml —
      so most of the theme needs no night override at all.

      Pixel (v56 step 2) owns the layout-level application of these tokens.
    -->
    <style name="Theme.DNKDialerCompanion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_pressed</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@drawable/bg_app_solid</item>
        <item name="android:statusBarColor">@color/surface_base</item>
        <item name="android:navigationBarColor">@color/surface_base</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Light surface → dark status-bar icons. Inverted in values-night. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- v56: the nav bar is the same page surface as the status bar, so
             its icon polarity has to match too. Without this the gesture pill
             is light-on-light in day mode on API 27+. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
