<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale (4dp grid).
         Round 7: tightened 20-30% vs Round 6. The R6 stack felt like a
         "tutorial app" — generous gutters for first-time setup. Modern
         pro tools (Linear, Vercel dashboards, Claude.ai) run dense.
         Section gutters 28/40 → 20/28. Padding stays for tap targets. -->
    <dimen name="space_2">2dp</dimen>
    <dimen name="space_4">4dp</dimen>
    <dimen name="space_6">6dp</dimen>
    <dimen name="space_8">8dp</dimen>
    <dimen name="space_10">10dp</dimen>
    <dimen name="space_12">12dp</dimen>
    <dimen name="space_14">14dp</dimen>
    <dimen name="space_16">16dp</dimen>
    <dimen name="space_20">20dp</dimen>
    <dimen name="space_24">24dp</dimen>
    <dimen name="space_28">28dp</dimen>
    <dimen name="space_32">32dp</dimen>
    <dimen name="space_40">40dp</dimen>
    <dimen name="space_56">56dp</dimen>

    <!-- Radii — slightly larger so the dark surfaces read as "screens"
         not "paper". 8 → 10 / 10 → 12. -->
    <dimen name="radius_chip">10dp</dimen>
    <dimen name="radius_button">12dp</dimen>
    <dimen name="radius_card">14dp</dimen>

    <!-- Stroke -->
    <dimen name="stroke_hairline">1dp</dimen>
    <dimen name="stroke_accent">2dp</dimen>

    <!-- Status dot — 12dp. Slightly smaller than R6's 14dp; the LIVE
         state now has a soft glow ring so visual weight comes from
         the halo, not the dot itself. -->
    <dimen name="dot_size">12dp</dimen>
    <dimen name="dot_ring_size">22dp</dimen>

    <!-- Buttons — kept tap-friendly at 52/42. -->
    <dimen name="button_height">52dp</dimen>
    <dimen name="button_height_small">42dp</dimen>

    <!-- Typography — Round 7 simplifies further. Display, body,
         caption, mono. The status size drops 22 → 20 to sit
         comfortably next to the smaller dot + ring. -->
    <dimen name="text_eyebrow">11sp</dimen>
    <dimen name="text_step_number">11sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_url">14sp</dimen>
    <dimen name="text_status">20sp</dimen>
    <dimen name="text_subtitle">18sp</dimen>
    <dimen name="text_wordmark">42sp</dimen>

    <!-- Wordmark accent underline — slightly thicker (2 → 3dp) and
         shorter (52 → 44dp) so it reads as a deliberate stroke under
         the wordmark, not a decorative line. -->
    <dimen name="wordmark_underline_width">44dp</dimen>
    <dimen name="wordmark_underline_height">3dp</dimen>

    <!-- QR — 200dp unchanged. -->
    <dimen name="qr_size">200dp</dimen>

    <!-- ================= v56 geometry (DIRECTION-android-v56.md) =========
         The mockups were authored at a 360dp phone width, so every px in
         mock.html is 1:1 a dp here. Names are geometric, not per-screen,
         because Home / Settings / Sign-in share the same pieces.

         Touch targets: the VISUAL sizes below (30dp icon tile, 36dp gear
         circle, 46x26 switch) are smaller than 48dp on purpose — each one
         sits inside a 48dp-or-taller hit area (a 56dp row, or a 48dp
         ImageButton with padding). Nothing tappable is under 48dp. -->
    <dimen name="cc_page_padding">18dp</dimen>
    <dimen name="cc_appbar_height">52dp</dimen>
    <dimen name="cc_row_height">56dp</dimen>
    <dimen name="cc_pill_height">50dp</dimen>
    <dimen name="cc_pill_height_small">44dp</dimen>
    <dimen name="cc_touch_min">48dp</dimen>

    <dimen name="cc_radius_pill">999dp</dimen>
    <dimen name="cc_radius_hero">20dp</dimen>
    <dimen name="cc_radius_group">16dp</dimen>
    <dimen name="cc_radius_band">14dp</dimen>
    <dimen name="cc_radius_tile">9dp</dimen>

    <dimen name="cc_mark_size">34dp</dimen>
    <dimen name="cc_mark_signin">112dp</dimen>
    <dimen name="cc_gear_size">36dp</dimen>
    <dimen name="cc_tile_size">30dp</dimen>
    <dimen name="cc_avatar_hero">86dp</dimen>
    <dimen name="cc_avatar_account">44dp</dimen>
    <dimen name="cc_presence_dot">9dp</dimen>
    <dimen name="cc_hero_padding">18dp</dimen>

    <!-- Type scale, straight off the direction's token block. -->
    <dimen name="cc_text_hero">21sp</dimen>
    <dimen name="cc_text_appbar">14.5sp</dimen>
    <dimen name="cc_text_button">14.5sp</dimen>
    <dimen name="cc_text_sub">13sp</dimen>
    <dimen name="cc_text_row_title">13sp</dimen>
    <dimen name="cc_text_presence">12.5sp</dimen>
    <dimen name="cc_text_meta">11.5sp</dimen>
    <dimen name="cc_text_section_label">10.5sp</dimen>
    <dimen name="cc_text_foot">11sp</dimen>
</resources>
