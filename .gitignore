# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — match node_modules at any depth, not just repo root.
# The unrooted `node_modules/` pattern catches nested package roots like
# dnkdialer-bridge/node_modules/ (which holds electron.exe at 201MB —
# blows past GitHub's 100MB push limit if accidentally tracked).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never committed. Example file IS committed
# (no secrets, just keys + format guidance for new envs).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android build artifacts — must never be committed
dnkdialer-android/.gradle/
dnkdialer-android/app/build/
dnkdialer-android/build/
dnkdialer-android/local.properties
dnkdialer-android/.idea/
*.iml
*.hprof

# IDE / editor caches
.vscode/.last-target
.idea/

# misc local
work/
dk-partner-work/
*.xlsx
*.apk
*.aab
dnkdialer-android/dnkdialer-v*.apk

# apk-releases/ — release artifact directory. We ignore everything in it
# by default and explicitly un-ignore ONLY the current signed release APK
# below. This ships exactly one binary with the repo (Coolify rsyncs the
# whole tree → container) so /api/download/apk can find it on disk, while
# keeping `.aab` Play Store bundles, bisect builds (`v14a-bisect-*.apk`),
# and historical versions OUT of git.
#
# Workflow on a new release: drop the new signed APK into apk-releases/,
# bump the version number in the negation line below, delete the previous
# tracked APK from the index (`git rm --cached apk-releases/<old>.apk`),
# `git add` the new one, commit, push, deploy. The route uses a regex to
# pick the highest version on disk — so during the brief window between
# `git add new` and `git rm --cached old`, both files coexist and the
# route picks the newer one. No downtime.
apk-releases/*
!apk-releases/computercaller-v30.apk
!apk-releases/computercaller-v35.apk

# Android signing — keystores + keystore.properties NEVER committed.
# Live at C:\Users\D\Keystores\ on the build box; passwords in
# agent-memory/niki/PROJECTS/computercaller/CREDS.md (also gitignored).
*.keystore
*.jks
dnkdialer-android/keystore.properties
dnkdialer-android/app/release/
dnkdialer-android/app/build/outputs/

# Prisma — local dev SQLite artifacts. Postgres migrations DO get
# committed (Coolify deploy runs `prisma migrate deploy` from them).
# The sqlite-mode rig + its migration trail have been retired as of
# Phase 1 of the deploy (2026-05-24); production runs Postgres.
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/20260522093753_init/
