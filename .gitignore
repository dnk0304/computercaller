# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — match node_modules at any depth, not just repo root.
# The unrooted `node_modules/` pattern catches nested package roots like
# dnkdialer-bridge/node_modules/ (which holds electron.exe at 201MB —
# blows past GitHub's 100MB push limit if accidentally tracked).
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never committed. Example file IS committed
# (no secrets, just keys + format guidance for new envs).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android build artifacts — must never be committed
dnkdialer-android/.gradle/
dnkdialer-android/app/build/
dnkdialer-android/build/
dnkdialer-android/local.properties
dnkdialer-android/.idea/
*.iml
*.hprof

# IDE / editor caches
.vscode/.last-target
.idea/

# misc local
work/
dk-partner-work/
*.xlsx
*.apk
dnkdialer-android/dnkdialer-v*.apk
apk-releases/

# Android signing — keystores + keystore.properties NEVER committed.
# Live at C:\Users\D\Keystores\ on the build box; passwords in
# agent-memory/niki/PROJECTS/computercaller/CREDS.md (also gitignored).
*.keystore
*.jks
dnkdialer-android/keystore.properties
dnkdialer-android/app/release/
dnkdialer-android/app/build/outputs/

# Prisma — local dev SQLite artifacts. Postgres migrations DO get
# committed (Coolify deploy runs `prisma migrate deploy` from them).
# The sqlite-mode rig + its migration trail have been retired as of
# Phase 1 of the deploy (2026-05-24); production runs Postgres.
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/20260522093753_init/
