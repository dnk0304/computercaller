# =============================================================
# ComputerCaller — environment variables
#
# Copy to .env.local for local dev (Next.js loads .env.local automatically)
# or set in your hosting provider's env panel for production (Coolify, etc).
# Never commit real values — .env* is gitignored.
# =============================================================

# --- Database -------------------------------------------------
# Production: PostgreSQL on Hetzner via Coolify-managed instance.
# Format: postgresql://USER:PASS@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/computercaller"

# --- Auth secrets ---------------------------------------------
# Generate fresh per environment: `openssl rand -hex 32`
# Rotating these invalidates every existing session — plan migrations.
JWT_SECRET="change-me-32-bytes-of-randomness"
JWT_REFRESH_SECRET="change-me-another-32-bytes-of-randomness"

# --- Email (Resend) -------------------------------------------
# Sending domain must be verified in the Resend dashboard with DKIM CNAMEs
# added to DNS. Empty key in dev triggers the auto-verify shortcut in
# app/api/auth/register/route.ts (no email sent, user marked verified).
RESEND_API_KEY=""
EMAIL_FROM="ComputerCaller <hello@computercaller.com>"
EMAIL_REPLY_TO="support@computercaller.com"

# --- App URL --------------------------------------------------
# Used in email links (verify, password reset) and the Whop checkout
# return path. Must be the public origin without trailing slash.
NEXT_PUBLIC_APP_URL="https://computercaller.com"

# --- Google OAuth (dispatch #36) -------------------------------
# Web client created in Google Cloud Console. The redirect URI must be
# registered there too: https://<your-domain>/api/auth/google/callback
# (or http://localhost:3000/... for local dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional — defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback.
# Override only if you're proxying or want a different path.
GOOGLE_REDIRECT_URI=""

# --- Whop (subscription billing) ------------------------------
# Server-side API key for Whop API calls.
WHOP_API_KEY=""
# Webhook secret — HMAC-SHA256 verifies every POST to /api/webhooks/whop.
# Find it in the Whop dashboard under your product's webhook config.
WHOP_WEBHOOK_SECRET=""
# Public checkout URL for the Subscribe buttons. Leave on a real product URL.
NEXT_PUBLIC_WHOP_CHECKOUT_URL="https://whop.com/computercaller/computercaller-82/"

# --- Pre-launch waitlist mode (reversible) --------------------
# When truthy (true/1/on/yes) the public marketing pages (/, /iphone) replace
# all "Start free trial" / "Sign in" / register / Whop-checkout CTAs with a
# "Join waitlist" email capture (POST /api/waitlist) and hide every public auth
# + payment entry point. Unset or falsy = original paid/trial site unchanged.
# Flip this one line to switch between waitlist and paid — no code change.
NEXT_PUBLIC_WAITLIST_MODE="true"
