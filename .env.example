# =============================================================
# ComputerCaller — environment variables
#
# Copy to .env.local for local dev (Next.js loads .env.local automatically)
# or set in your hosting provider's env panel for production (Coolify, etc).
# Never commit real values — .env* is gitignored.
# =============================================================

# --- Database -------------------------------------------------
# Production: PostgreSQL on Hetzner via Coolify-managed instance.
# Format: postgresql://USER:PASS@HOST:5432/DB?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/computercaller"

# --- Auth secrets ---------------------------------------------
# Generate fresh per environment: `openssl rand -hex 32`
# Rotating these invalidates every existing session — plan migrations.
JWT_SECRET="change-me-32-bytes-of-randomness"
JWT_REFRESH_SECRET="change-me-another-32-bytes-of-randomness"

# --- Email (Resend) -------------------------------------------
# Sending domain must be verified in the Resend dashboard with DKIM CNAMEs
# added to DNS. Empty key in dev triggers the auto-verify shortcut in
# app/api/auth/register/route.ts (no email sent, user marked verified).
RESEND_API_KEY=""
EMAIL_FROM="ComputerCaller <hello@computercaller.com>"
EMAIL_REPLY_TO="support@computercaller.com"

# --- App URL --------------------------------------------------
# Used in email links (verify, password reset) and the Whop checkout
# return path. Must be the public origin without trailing slash.
NEXT_PUBLIC_APP_URL="https://computercaller.com"

# --- Google OAuth (dispatch #36) -------------------------------
# Web client created in Google Cloud Console. The redirect URI must be
# registered there too: https://<your-domain>/api/auth/google/callback
# (or http://localhost:3000/... for local dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional — defaults to ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback.
# Override only if you're proxying or want a different path.
GOOGLE_REDIRECT_URI=""

# --- Whop (subscription billing) ------------------------------
# Server-side API key for Whop API calls.
WHOP_API_KEY=""
# Webhook secret — HMAC-SHA256 verifies every POST to /api/webhooks/whop.
# Find it in the Whop dashboard under your product's webhook config.
WHOP_WEBHOOK_SECRET=""
# Public checkout URL for the Subscribe buttons. Leave on a real product URL.
NEXT_PUBLIC_WHOP_CHECKOUT_URL="https://whop.com/computercaller/computercaller-82/"

# --- Pre-launch waitlist mode (reversible) --------------------
# When truthy (true/1/on/yes) the public marketing pages (/, /iphone) replace
# all "Start free trial" / "Sign in" / register / Whop-checkout CTAs with a
# "Join waitlist" email capture (POST /api/waitlist) and hide every public auth
# + payment entry point. Unset or falsy = original paid/trial site unchanged.
# Flip this one line to switch between waitlist and paid — no code change.
NEXT_PUBLIC_WAITLIST_MODE="true"

# --- FREE_TIER — the no-card free tier switch (reversible, runtime) ---------
# Governs entitlement rule (3) ONLY: "a logged-in user with NO Subscription row".
#   unset / on / true / 1 / yes   -> free tier ON  (the code default)
#   off / false / 0 / no          -> CARD-FIRST: no subscription = denied
#                                    (state 'needs_subscription'), bounced to
#                                    /subscribe -> Whop checkout -> card -> trial
#   any unrecognised value        -> ON (fail-safe: a typo must never mass-deny)
#
# Read from process.env on EVERY evaluation, not inlined at build time, so a
# Coolify env edit rolls the gate back on the NEXT REQUEST with no redeploy.
#
# EXEMPT in both states (evaluated strictly earlier): admin, ENTITLEMENT_ALLOWLIST
# (see the IDENTITY block below), free-access grants, and every user with a
# Subscription row — active, trialing, or comped.
# ALSO EXEMPT: accounts with User.freeTierGrandfathered = true, i.e. everyone who
# signed up while the free tier was advertised. Run
# `node scripts/backfill-free-tier-grandfather.mjs` (dry run first, then --apply)
# BEFORE setting this to off.
#
# Left UNSET here on purpose: the safe default is today's behaviour.
# FREE_TIER="off"

# --- IDENTITY / ACCESS CONTROL (REQUIRED IN PRODUCTION) --------------------
# 2026-09-17, dispatch forge/w-strip-email-literals.
#
# These three used to have HARDCODED email fallbacks in the source. Because
# lib/entitlement-core.js is plain CommonJS it cannot be tree-shaken, so when a
# 'use client' component transitively imported it, those real addresses shipped
# to every visitor in a publicly fetchable _next/static chunk. The fallbacks are
# gone. All three are now read from the environment at call time and FAIL CLOSED
# when unset.
#
# ⚠️ A deploy that omits these does NOT crash — it silently removes access:
#   ADMIN_EMAIL unset            -> the email route to admin is disabled; admin
#                                   then depends solely on the User.isAdmin DB
#                                   flag. Logged once at first check as
#                                   "[entitlement] ADMIN_EMAIL unset — admin disabled".
#   ENTITLEMENT_ALLOWLIST unset  -> nobody gets the paywall bypass (the Play
#                                   reviewer account loses free access).
#   AUTH_ALLOWLIST unset         -> while WAITLIST_MODE is ON, nobody may log in
#                                   at all. Irrelevant while signups are open.
#
# AUTH_ALLOWLIST and ENTITLEMENT_ALLOWLIST are DELIBERATELY SEPARATE lists (see
# lib/auth.ts): one gates who may LOG IN, the other who bypasses the PAYWALL.
# Do not point one at the other — that would hand free product to every account
# permitted to sign in.

# Single email address with admin authority (case-insensitive, trimmed).
ADMIN_EMAIL=owner@example.com

# CSV of emails that bypass the paid/trial lock (entitlement rule 2).
ENTITLEMENT_ALLOWLIST=owner@example.com,reviewer@example.com

# CSV of emails permitted to log in while WAITLIST_MODE is on.
AUTH_ALLOWLIST=owner@example.com,reviewer@example.com
